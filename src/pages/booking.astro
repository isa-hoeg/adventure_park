---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
---

<MainLayout>
  <main class="bg-bg-beige-200 p-6 lg:px-20">
    <div class="flex justify-center items-center pb-10">
      <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-stronger text-center whitespace-nowrap p-5 lg:p-10">book din aktivitet her!</Heading>
    </div>
    <div class="flex flex-col lg:flex-row justify-between gap-10 mb-20">
      <section class="bg-bg-beige-300 rounded-lg lg:w-200">
        <!-- ============================================================ -->
        <!-- PROGRESSBAR - viser de fire trin med en linje imellem        -->
        <!-- ============================================================ -->
        <!-- 
          LAYOUT: Flexbox med "justify-between" fordeler de fire trin jævnt
          ud over bredden (første yderst til venstre, sidste yderst til højre).
          Det gør progressbaren responsiv på alle skærmstørrelser.

          LINJEN: En vandret streg bag cirklerne. Den skubbes ind fra hver side
          (left/right) med en halv cirkelbredde, så den går fra midten af første
          cirkel til midten af sidste - i stedet for helt ud til kanten.

          JAVASCRIPT: Hvert trin har "data-step" så JavaScript kan finde det,
          markere det aktive trin og sætte check-ikon på de gennemførte trin.
        -->
        <div class="p-6 lg:p-10">
          <div class="relative flex flex-row justify-between items-start">
            <!-- LINJE bag cirklerne -->
            <div class="absolute top-4 lg:top-6 left-[18px] right-[18px] lg:left-[24px] lg:right-[24px] h-0.5 bg-bg-beige-500"></div>

            <!-- TRIN 1 -->
            <div class="relative flex flex-col items-center gap-2" data-step="1">
              <div class="bg-bg-beige-200 border-2 border-stroke-primary-accent w-9 h-9 rounded-full flex items-center justify-center lg:w-12 lg:h-12">
                <Text teksttype="brødtekst-card" stylingclasses="text-stronger font-semibold">1</Text>
              </div>
              <Text teksttype="brødtekst-card" stylingclasses="text-stronger text-center">Aktiviteter</Text>
            </div>

            <!-- TRIN 2 -->
            <div class="relative flex flex-col items-center gap-2" data-step="2">
              <div class="bg-bg-beige-400 border-1 border-bg-beige-500 w-9 h-9 rounded-full flex items-center justify-center lg:w-12 lg:h-12">
                <Text teksttype="brødtekst-card" stylingclasses="text-weak">2</Text>
              </div>
              <Text teksttype="brødtekst-card" stylingclasses="text-weak text-center">Dato & tid</Text>
            </div>

            <!-- TRIN 3 -->
            <div class="relative flex flex-col items-center gap-2" data-step="3">
              <div class="bg-bg-beige-400 border-1 border-bg-beige-500 w-9 h-9 rounded-full flex items-center justify-center lg:w-12 lg:h-12">
                <Text teksttype="brødtekst-card" stylingclasses="text-weak text-center">3</Text>
              </div>
              <Text teksttype="brødtekst-card" stylingclasses="text-weak text-center">Oplysninger</Text>
            </div>

            <!-- TRIN 4 -->
            <div class="relative flex flex-col items-center gap-2" data-step="4">
              <div class="bg-bg-beige-400 border-1 border-bg-beige-500 w-9 h-9 rounded-full flex items-center justify-center lg:w-12 lg:h-12">
                <Text teksttype="brødtekst-card" stylingclasses="text-weak text-center">4</Text>
              </div>
              <Text teksttype="brødtekst-card" stylingclasses="text-weak text-center">Bekræftelse</Text>
            </div>
          </div>
        </div>

        <!-- ============================================================ -->
        <!-- TRIN 1 - VALG AF AKTIVITET                                   -->
        <!-- ============================================================ -->
        <!-- 
          Klassen "step" gør at JavaScript kan finde alle trin som én liste.
          Trin 1 har IKKE "hidden", da det skal være synligt fra start.
        -->
        <div class="step flex flex-col gap-6 p-6 mt-8 lg:gap-8 lg:p-8 lg:mt-6">
          <div class="flex flex-col gap-x-2 gap-y-2 md:flex-row lg:flex-row lg:gap-4">
            <div class="relative lg:flex-1 w-full">
              <select id="aktivitet" name="aktivitet" class="cursor-pointer bg-bg-beige-200 border-1 border-stroke-dark px-4 py-3 text-stronger text-sm lg:text-base font-body w-full appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0">
                <option value="">Vælg aktivitet</option>
                <option>Bowtag</option>
                <option>Bueskydning</option>
                <option>Dødningbold</option>
                <option>Forhindringsbane</option>
                <option>Hardball</option>
                <option>Kæmpe Bordfodbold</option>
                <option>Lasertag</option>
                <option>Megaboksning</option>
                <option>Paintball</option>
                <option>Spydkast</option>
                <option>Stokkekamp</option>
                <option>Sumobrydning</option>
              </select>
              <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-2xl"></span>
            </div>
            <div class="relative lg:flex-1 w-full">
              <select id="tid" name="tid" class="cursor-pointer bg-bg-beige-200 border-1 border-stroke-dark px-4 py-3 text-stronger text-sm lg:text-base font-body w-full appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0">
                <option value="">Vælg varighed</option>
                <option>1 time</option>
                <option>2 timer</option>
              </select>
              <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-2xl"></span>
            </div>
            <div class="lg:flex-1 w-full">
              <input id="amount" type="number" min="1" max="50" required name="antal" placeholder="Antal deltagere" class="bg-bg-beige-200 border-1 border-stroke-dark placeholder:text-strong px-4 py-3 text-sm lg:text-base appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0 w-full " />
            </div>
          </div>

          <!-- TILFØJER NY RÆKKE (her indsættes ekstra aktiviteter via JavaScript) -->
          <div id="activitiesWrapper" class="flex flex-col gap-4"></div>

          <button type="button" id="addActivity" class="cursor-pointer w-fit inline-flex items-center gap-3 border-b-2 border-stroke-dark text-stronger hover:font-semibold p-1 text-sm lg:text-base"
            >Tilføj flere aktiviteter
            <span class="text-3xl leading-none">+</span>
          </button>

          <!-- CHECKBOX - TILKØB AF SPISNING -->
          <div class="flex flex-col">
            <div class="flex flex-row gap-2 items-center">
              <input id="tilkobSpisning" type="checkbox" value="" name="checkbox" class="w-4 h-4 text-bg-army-700 rounded-full checked:border-neongreen-400 focus:ring-2 focus:outline-none border border-default appearance-none hover:cursor-pointer" />
              <div class="flex flex-col">
                <label for="tilkobSpisning" class="select-none text-sm lg:text-base font-body">Tilkøb spisning efter endt aktivitet</label>
                <label for="tilkobSpisning" class="select-none text-sm lg:text-base font-body text-strong">Det er også muligt at medbringe eget mad</label>
              </div>
            </div>
          </div>

          <!-- SPISNINGS-FELTER - skjult som standard, vises når checkboxen sættes -->
          <div id="spisningFields" class="hidden flex-col gap-6">
            <div class="flex flex-col gap-x-2 gap-y-2 md:flex-row lg:flex-row lg:gap-4">
              <div class="relative lg:flex-1 w-full">
                <select id="menu" name="menu" class="cursor-pointer bg-bg-beige-200 border-1 border-stroke-dark px-4 py-3 text-stronger text-sm lg:text-base font-body w-full appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0">
                  <option value="">Vælg Menu</option>
                  <option>Kyllingburger Menu</option>
                  <option>Okseburger Menu</option>
                  <option>Sandwich & Frugt</option>
                  <option>Mix Grill Menu</option>
                  <option>Grill Selv Buffet</option>
                  <option>Kage Buffet</option>
                  <option>Grill Buffet</option>
                  <option>børnefødselsdags Menu</option>
                </select>
                <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-2xl"></span>
              </div>
              <div class="lg:flex-1 w-full">
                <input id="amount" type="number" min="1" max="50" required name="antal" placeholder="Antal deltagere" class="bg-bg-beige-200 border-1 border-stroke-dark placeholder:text-strong px-4 py-3 text-sm lg:text-base appearance-none w-full focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0" />
              </div>
            </div>

            <!-- ALLERGENER - TEKSTBOKS -->
            <div class="w-full">
              <label for="allergener" class="block text-sm lg:text-base font-body mb-2">Allergener</label>
              <textarea id="allergener" placeholder="Skriv hvis der er nogle med allergener, samt antallet" class="w-full min-h-40 bg-bg-beige-200 border-1 border-stroke-dark placeholder:text-strong px-4 py-3 appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0"></textarea>
            </div>
          </div>

          <!-- "next-btn" klassen gør at JavaScript kan finde knappen og gå videre -->
          <div class="flex justify-end">
            <Link href="#" variant="tertiary" size="small" class="next-btn">Fortsæt</Link>
          </div>

          <!-- SKABELON - klones af JavaScript når man klikker "Tilføj flere aktiviteter" -->
          <template id="activityTemplate">
            <div class="flex flex-col gap-x-2 gap-y-2 md:flex-row lg:flex-row lg:gap-4">
              <!-- VÆLG AKTIVITET -->
              <div class="relative lg:flex-1 w-full">
                <select name="aktivitet" class="cursor-pointer bg-bg-beige-200 border-1 border-stroke-dark px-4 py-3 text-stronger text-sm lg:text-base font-body w-full appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0">
                  <option value="">Vælg aktivitet</option>
                  <option>Bowtag</option>
                  <option>Bueskydning</option>
                  <option>Dødningbold</option>
                  <option>Forhindringsbane</option>
                  <option>Hardball</option>
                  <option>Kæmpe Bordfodbold</option>
                  <option>Lasertag</option>
                  <option>Megaboksning</option>
                  <option>Paintball</option>
                  <option>Spydkast</option>
                  <option>Stokkekamp</option>
                  <option>Sumobrydning</option>
                </select>
                <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-2xl"></span>
              </div>

              <!-- VÆLG VARIGHED -->
              <div class="relative lg:flex-1 w-full">
                <select name="tid" class="cursor-pointer bg-bg-beige-200 border-1 border-stroke-dark px-4 py-3 text-stronger text-sm lg:text-base font-body w-full appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0">
                  <option value="">Vælg varighed</option>
                  <option>1 time</option>
                  <option>2 timer</option>
                </select>
                <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-2xl"></span>
              </div>

              <!-- ANTAL DELTAGERE -->
              <div class="lg:flex-1 w-full">
                <input type="text" name="antal" placeholder="Antal deltagere" class="bg-bg-beige-200 border-1 border-stroke-dark placeholder:text-strong px-4 py-3 text-sm lg:text-base appearance-none w-full focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0" />
              </div>
            </div>
          </template>
        </div>

        <!-- ============================================================ -->
        <!-- TRIN 2 - DATO & TID                                          -->
        <!-- ============================================================ -->
        <div class="step hidden flex-col gap-4 p-6 lg:p-8">
          <!-- Kalender + tidspunkt ved siden af hinanden på desktop -->
          <div class="flex flex-col lg:flex-row gap-4 lg:gap-10">
            <div class="flex flex-col gap-2">
              <label for="dato" class="block text-sm lg:text-base font-body">Vælg dato</label>
              <calendar-date class="cally bg-bg-beige-200 border border-stroke-dark rounded-box">
                <svg aria-label="Previous" class="fill-current size-4" slot="previous" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="M15.75 19.5 8.25 12l7.5-7.5"></path></svg>
                <svg aria-label="Next" class="fill-current size-4" slot="next" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path></svg>
                <calendar-month></calendar-month>
              </calendar-date>
            </div>

            <div>
              <label for="dato" class="block text-sm lg:text-base font-body mb-2">Vælg start tidspunkt</label>
              <div class="flex flex-row gap-1 lg:justify-center items-center">
                <Text teksttype="brødtekst-body">kl.</Text>
                <input id="time" type="number" name="time" placeholder="12" class="bg-bg-beige-200 border-1 border-stroke-dark placeholder:text-strong px-4 py-3 text-sm lg:text-base appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0 w-20 lg:w-30" />
                <Text teksttype="brødtekst-body">:</Text>
                <input id="minutter" type="text" name="minutter" placeholder="30" class="bg-bg-beige-200 border-1 border-stroke-dark placeholder:text-strong px-4 py-3 text-sm lg:text-base appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0 w-20 lg:w-30" />
              </div>
            </div>
          </div>

          <!-- Tilbage + Fortsæt knapper -->
          <div class="flex justify-between">
            <Link href="#" variant="tertiary" size="small" class="prev-btn">Tilbage</Link>
            <Link href="#" variant="tertiary" size="small" class="next-btn">Fortsæt</Link>
          </div>
        </div>

        <!-- ============================================================ -->
        <!-- TRIN 3 - OPLYSNINGER                                         -->
        <!-- ============================================================ -->
        <div class="step hidden flex-col gap-4 p-6 lg:p-8">
          <div class="flex flex-col lg:flex-row gap-4">
            <div class="flex flex-col gap-2 flex-1">
              <label for="fornavn" class="block text-sm lg:text-base font-body text-stronger">Fornavn</label>
              <input id="fornavn" type="text" name="fornavn" placeholder="Lars" class="bg-bg-beige-200 border-1 border-stroke-dark placeholder:text-strong px-4 py-3 appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0 text-sm lg:text-base" />
            </div>
            <div class="flex flex-col gap-2 flex-1">
              <label for="efternavn" class="block text-sm lg:text-base font-body text-stronger">Efternavn</label>
              <input id="efternavn" type="text" name="efternavn" placeholder="Petersen" class="bg-bg-beige-200 border-1 border-stroke-dark placeholder:text-strong px-4 py-3 appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0 text-sm lg:text-base" />
            </div>
          </div>
          <div class="flex flex-col lg:flex-row gap-4">
            <div class="flex flex-col gap-2 flex-1">
              <label for="email" class="block text-sm lg:text-base font-body text-stronger">E-mail</label>
              <input id="email" type="text" name="email" placeholder="larspetersen@gmail.com" class="bg-bg-beige-200 border-1 border-stroke-dark placeholder:text-strong px-4 py-3 appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0 text-sm lg:text-base" />
            </div>
            <div class="flex flex-col gap-2 flex-1">
              <label for="tlf" class="block text-sm lg:text-base font-body text-stronger">Telefon</label>
              <input id="tlf" type="number" name="tlf" placeholder="+45" class="bg-bg-beige-200 border-1 border-stroke-dark placeholder:text-strong px-4 py-3 appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0 text-sm lg:text-base" />
            </div>
          </div>
          <div class="flex flex-col gap-2 flex-1">
            <label for="adresse" class="block text-sm lg:text-base font-body text-stronger">Adresse</label>
            <input id="adresse" type="text" name="adresse" placeholder="Nordre Fasanvej 12" class="bg-bg-beige-200 border-1 border-stroke-dark placeholder:text-strong px-4 py-3 appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0 text-sm lg:text-base" />
          </div>
          <div class="flex flex-col flex-1">
            <label for="kommentarer" class="block text-sm lg:text-base font-body mb-2">Kommentarer & Særlige ønsker</label>
            <textarea id="kommentarer" placeholder="Skriv hvis I har særlige ønsker til arrangementet" class="min-h-40 bg-bg-beige-200 border-1 border-stroke-dark placeholder:text-strong px-4 py-3 appearance-none focus:border-2 focus:outline-none focus:border-stroke-dark focus:ring-0 text-sm lg:text-base"></textarea>
          </div>

          <!-- HANDELSBETINGELSER -->
          <div class="flex flex-col pb-6">
            <div class="flex flex-row gap-2 items-center">
              <input id="handelsbetingelser" type="checkbox" value="" name="checkbox" class="w-4 h-4 text-bg-army-700 rounded-full checked:border-neongreen-400 focus:ring-2 focus:outline-none border border-default appearance-none hover:cursor-pointer" />
              <div class="flex flex-col">
                <label for="handelsbetingelser" class="select-none text-sm lg:text-base font-heading">Accepter handelsbetingelser</label>
                <!-- Åbn dialogen -->
                <button type="button" onclick="document.body.classList.add('modal-open'); document.getElementById('terms').showModal();" class="text-strong underline cursor-pointer "> Læs om handelsbetingelserne her</button>
              </div>
            </div>
          </div>

          <!-- 
            "Book nu" er en <button type="submit"> (ikke en <Link>) fordi den sender formularen.
            En button har ingen styling fra start, så klasserne nedenfor er kopieret 1:1 fra 
            Link.astro's variant="primary" + size="small", så den ser ud som de andre knapper.
          -->
          <div class="flex justify-between">
            <Link href="#" variant="tertiary" size="small" class="prev-btn">Tilbage</Link>
            <button type="submit" class="next-btn flex border-1 justify-center px-4 py-2 border-stroke-dark bg-primary-accent font-heading font-semibold text-stronger hover:bg-primary hover:text-neongreen-400 uppercase text-xs lg:text-sm cursor-pointer">Book nu</button>
          </div>
        </div>

        <!-- ============================================================ -->
        <!-- TRIN 4 - BEKRÆFTELSE                                         -->
        <!-- ============================================================ -->
        <div class="step hidden flex-col gap-1 p-10 py-20 justify-center items-center lg:py-10">
          <Heading htmlheading="h3" size="small" font="heading" stylingclasses="text-center lg:pt-20">DU HAR NU BOOKET!</Heading>
          <Text teksttype="brødtekst-body" stylingclasses="text-stronger text-center w-full lg:w-130"><strong>Bemærk:</strong> Alle bookinger skal foretages og bliver bekræftet skriftligt. Bookinger er bindende og kan ikke afbestilles den sidste uge inden arrangementet.</Text>
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- BOOKING OVERSIGT - højre side, udfyldes dynamisk             -->
      <!-- ============================================================ -->
      <section class="lg:w-100 bg-bg-beige-300 p-6 rounded-xl h-fit flex flex-col gap-4">
        <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">Booking oversigt</Heading>

        <!-- AKTIVITET - altid synlig, felterne udfyldes når man vælger -->
        <div id="oversigt-aktivitet" class="flex flex-col gap-2">
          <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="">Aktivitet</Heading>
          <div class="flex flex-row gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#323232" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lg:w-7 lg:h-7"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path><path d="m9 12 2 2 4-4"></path></svg>
            <Text teksttype="brødtekst-body" stylingclasses="text-stronger"><span id="vis-aktivitet"></span></Text>
          </div>
          <div class="flex flex-row gap-2">
            <img src="/ur_ikon.svg" alt="tid" class="lg:w-7 lg:h-7" />
            <Text teksttype="brødtekst-body" stylingclasses="text-stronger"><span id="vis-varighed"></span></Text>
          </div>
          <div class="flex flex-row gap-2">
            <img src="/personer_ikon.svg" alt="personer" class="lg:w-7 lg:h-7" />
            <Text teksttype="brødtekst-body" stylingclasses="text-stronger"><span id="vis-antal"></span></Text>
          </div>
        </div>

        <!-- DATO & TID - altid synlig -->
        <div id="oversigt-dato" class="flex flex-col gap-2 border-t border-stroke-dark py-4">
          <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="">Dato & tid</Heading>
          <div class="flex flex-row gap-2">
            <img src="/icons/calendar.svg" alt="dato" class="lg:w-7 lg:h-7" />
            <Text teksttype="brødtekst-body" stylingclasses="text-stronger"><span id="vis-tidspunkt"></span></Text>
          </div>
        </div>

        <!-- I ALT -->
        <div class="border-t border-stroke-dark flex flex-row justify-between pt-2">
          <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="">I alt</Heading>
          <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses=""><span id="vis-total">0</span> kr</Heading>
        </div>
      </section>

      <dialog id="terms" class="backdrop:bg-black/50 p-6 rounded-lg w-full fixed inset-0 m-auto lg:w-[600px] ">
        <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">Handelsbetingelser</Heading>
        <div class="flex flex-col gap-6 mb-6">
          <Text teksttype="brødtekst-card">Booking betingelser og ordensreglement for Adventurepark</Text> 
          <div>
            <Heading htmlheading="h4" size="xxsmall" font="heading" stylingclasses="text-stronger">1. Generelt:</Heading>
            <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Ved booking af arrangementer i Adventurepark forventes kunden at have læst og accepteret disse betingelser. Betingelserne finder anvendelse, medmindre andet skriftligt er aftalt mellem kunden og Adventurepark.</Text>
          </div>
          <div>
            <Heading htmlheading="h4" size="xxsmall" font="heading" stylingclasses="text-stronger">2. Priser:</Heading>
            <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Alle priser angives i danske kroner inklusiv moms, danske skatter og afgifter.</Text>
          </div>
          <div>
            <Heading htmlheading="h4" size="xxsmall" font="heading" stylingclasses="text-stronger">3. Betaling:</Heading>
            <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Hele beløbet for arrangementet betales på dagen - med mindre andet er aftalt skriftligt. Der kan betales med kontanter og med Dankort.</Text>
          </div>
          <div>
            <Heading htmlheading="h4" size="xxsmall" font="heading" stylingclasses="text-stronger">4. Sikkerhed & personoplysninger:</Heading>
            <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Informationer der indsamles på websiden videresælges ikke. Informationen anvendes alene internt i virksomheden og til kontakt med kunden.</Text>
          </div>
          <div>
            <Heading htmlheading="h4" size="xxsmall" font="heading" stylingclasses="text-stronger">5. Booking:</Heading>
            <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Alle bookinger skal foretages skriftligt ved at udfylde kontakt formular på website. Når bookingen er endelig vil kunden modtage en skriftlig bekræftelse på den email adresse, der er angivet i formularen.</Text>
          </div>
          <div>
            <Heading htmlheading="h4" size="xxsmall" font="heading" stylingclasses="text-stronger">6. Fortrydelsesret / afbestilling:</Heading>
            <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Ønsker en kunde at ændre eller afbestille booking, kan dette gøres op til 1 uge før selve arrangement. De sidste 7 dage før arrangementsdagen, hæfter kunden økonomisk for det arrangement, der er booket.</Text>
          </div>
          <div>
            <Heading htmlheading="h4" size="xxsmall" font="heading" stylingclasses="text-stronger">7. Aflysning / refundering m.v.:</Heading>
            <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Bookingen kan aflyses på grund af udefra kommende omstændigheder, som Adventurepark og dets samarbejdspartnere ikke har indflydelse på eller haft mulighed for at forudse. Adventurepark er ikke ansvarlig for force majeure . I dette tilfælde refunderes arrangementets fulde pris, og kunden kan derudover ikke gøre krav på erstatning. Adventurepark kan aldrig gøres erstatningsansvarlige for beløb udover det beløb, der er betalt for arrangementet.</Text>
          </div>
          <div>
            <Heading htmlheading="h4" size="xxsmall" font="heading" stylingclasses="text-stronger">8. Erstatning:</Heading>
            <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Alle former for ophold og færdsel i Adventurepark sker på den besøgendes eget ansvar.
            Alle former for hærværk på Adventureparks område - rettet mod Adventurepark eller andre kunder/brugere vil kunne medføre politianmeldelse samt mulighed for et civilt søgsmål. Personer, der udviser en adfærd og/eller udfører en handling, som påfører Adventurepark tab i form af bøder og/eller sanktioner for virksomheden, vil blive gjort personligt ansvarlige for Adventureparks tab, og vil modtage et erstatningskrav.</Text>
          </div>
          <div>
            <Heading htmlheading="h4" size="xxsmall" font="heading" stylingclasses="text-stronger">9. Bortvisning / karantæne m.v.:</Heading>
            <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Overtrædelse af ordensreglementet kan uden videre føre til bortvisning og karantæne af gæster. Instruktøren er berettiget til at bortvise enkelt personer - og persongrupper, såfremt overtrædelsen ikke kan tilordnes en enkelt person eller overtrædelsen i øvrigt er karakteristisk for hele gruppens opførsel. Bortvisning/udelukkelse som følge af deltagernes egne forhold, berettiger ikke til nogen form for erstatning.</Text>
          </div>
          <div>
            <Heading htmlheading="h4" size="xxsmall" font="heading" stylingclasses="text-stronger">10. Reklamation:</Heading>
            <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Reklamation over mangler under arrangementet skal rettes til Adventureparks instruktører på dagen og skriftligt senest 5 dage efter afvikling.</Text>
          </div>
          <div class="flex flex-col gap-4">
            <div>
              <Heading htmlheading="h4" size="xxsmall" font="heading" stylingclasses="text-stronger">Ordensreglement og sikkerhedsregler i AdventurePark.</Heading>
              <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Alle gæster i AdventurePark forpligter sig til at overholde de instrukser og sikkerhedsregler, der gives af instruktørerne i AdventurePark inden hver aktivitet påbegyndes. Det er strengt forbudt at gå ind på områder, hvor der er andre aktiviteter i gang end den aktivitet man selv deltager i. Gæsterne må ikke benytte andet udstyr end det udstyr, der er blevet udleveret eller godkendt af AdventureParks instruktører.</Text>
            </div>
            <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Det er forbudt at være påvirket af nogen form for alkohol eller euforiserende stoffer, før eller under aktiviteterne i Adventurepark</Text>
            <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Instruktørerne i AdventurePark har ret til at nægte gæster at deltage i aktiviteterne i AdventurePark, hvis de vurderer at det ikke er sikkert. Hvis en deltager bevidst overskrider sikkerhedsreglerne, ikke adlyder instruktørens påbud eller på anden måde er til gene eller fare for sine omgivelser, kan dette medføre øjeblikkelig bortvisning. Bortviste gæster vil ikke få refunderet deres depositum/betaling for dagens aktiviteter.</Text>
          </div>
          <div class="flex flex-col gap-4">
            <div>
              <Heading htmlheading="h4" size="xxsmall" font="heading" stylingclasses="text-stronger">Resten skal kun læses hvis paintball er en del af arrangementet !!!!</Heading>
              <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Det er et krav fra myndighederne og Adventurepark at man minimum er fyldt 16 for at kunne deltage i paintballspil. 16 og 17-årige må kun deltage med skriftlig samtykke fra værge. Gyldig billedlegitimation skal kunne fremvises.</Text>
            </div>
            <Text teksttype="brødtekst-card" stylingclasses="text-stronger">Paintballmarkøren (skyderen) må aldrig tages med ud fra spilleområdet, og der skal altid bæres godkendt sikkerhedsmaske på spilleområdet under et paintballarrangement. Der er en sikkerhedsafstand på minimum 1 meter. Er man indenfor 1 meter skal der råbes ”bang, du er død” til vedkommende i stedet for at skyde. Det er ikke tilladt bevidst at sigte eller skyde efter hovedet. Det er ikke tilladt bevidst at komme i fysisk kontakt med hinanden under spillet.</Text>
          </div>     
        </div>

        <div class="flex justify-end gap-2">
          <Button variant="secondary" size="small" onclick="document.body.classList.remove('modal-open'); document.getElementById('terms').close();"> Luk </Button>
          <Button variant="primary" size="small" onclick="document.getElementById('terms').close(); document.getElementById('handelsbetingelser').checked = true;">Accepter</Button>
        </div>
      </dialog>
    </div>
  </main>
</MainLayout>

<!-- 
  KALENDER-FARVER (cally web component)
  Cally-kalenderen bruger sine egne CSS-variabler (kommer fra daisyUI) til at
  style den valgte dag. Vi kan ikke style den direkte med Tailwind fordi
  kalenderen ligger i en "shadow DOM" (et lukket område som CSS udefra ikke
  kan nå ind i). Løsningen er at overskrive cally's CSS-variabler:
  --color-primary         = baggrundsfarven på den valgte dag (gul neongrøn)
  --color-primary-content = tekstfarven på den valgte dag (mørk)
-->
<style>
  calendar-month {
    --color-primary: #ecff37;
    --color-primary-content: #323232;
  }
</style>

<!-- Importerer cally-kalenderen -->
<script>
  import "cally";
</script>

<!-- ============================================================ -->
<!-- TRIN-NAVIGATION - viser ét trin ad gangen                    -->
<!-- ============================================================ -->
<script>
  // Finder alle trin, knapper og progressbar-cirkler som lister
  const trin = document.querySelectorAll(".step");
  const naesteKnapper = document.querySelectorAll(".next-btn");
  const forrigeKnapper = document.querySelectorAll(".prev-btn");
  const progressTrin = document.querySelectorAll("[data-step]");

  // Husker hvilket trin vi er på (0 = første trin, da lister tæller fra 0)
  let aktivtTrin = 0;

  // Viser kun det aktive trin og opdaterer progressbarens cirkler.
  function visTrin() {
    // 1. Vis/skjul selve trinene
    trin.forEach((t, index) => {
      if (index === aktivtTrin) {
        t.classList.remove("hidden");
        t.classList.add("flex");
      } else {
        t.classList.add("hidden");
        t.classList.remove("flex");
      }
    });

    // 2. Opdater progressbarens cirkler (tre tilstande: gennemført, aktiv, kommende)
    progressTrin.forEach((p, index) => {
      const cirkel = p.querySelector("div"); // den runde cirkel
      if (!cirkel) return;

      const tal = (cirkel.querySelector("span") || cirkel) as HTMLElement; // tallet inde i cirklen

      // Nulstil alle styling-klasser på cirklen først, så vi starter rent
      cirkel.classList.remove("bg-bg-beige-200", "border-2", "border-stroke-primary-accent", "bg-bg-beige-400", "border-1", "border-bg-beige-500", "bg-neongreen-400", "border-neongreen-400");

      // Nulstil tekstfarven på tallet, så vi styrer den herfra (ikke fra HTML'en)
      tal.classList.remove("text-stronger", "text-weak", "font-semibold");

      if (index < aktivtTrin) {
        // GENNEMFØRT - gul udfyldt cirkel med check-ikon
        cirkel.classList.add("bg-neongreen-400", "border-2", "border-neongreen-400");
        tal.innerHTML = '<img src="/icons/check-booking-icon.svg" alt="gennemført" class="w-10 h-10">';
      } else if (index === aktivtTrin) {
        // AKTIV - lys cirkel med gul kant og mørkt tal
        cirkel.classList.add("bg-bg-beige-200", "border-2", "border-stroke-primary-accent");
        tal.classList.add("text-stronger", "font-semibold");
        tal.textContent = String(index + 1);
      } else {
        // KOMMENDE - brun cirkel med svagt tal (forbliver brun indtil man når dertil)
        cirkel.classList.add("bg-bg-beige-400", "border-1", "border-bg-beige-500");
        tal.classList.add("text-weak");
        tal.textContent = String(index + 1);
      }
    });
  }

  // Klik på "gå videre" rykker et trin frem (hvis vi ikke er på sidste trin).
  // preventDefault() forhindrer at links hopper til toppen af siden.
  naesteKnapper.forEach((knap) => {
    knap.addEventListener("click", (event) => {
      event.preventDefault();
      if (aktivtTrin < trin.length - 1) {
        aktivtTrin++;
        visTrin();
      }
    });
  });

  // Klik på "tilbage" rykker et trin tilbage (hvis vi ikke er på første trin).
  forrigeKnapper.forEach((knap) => {
    knap.addEventListener("click", (event) => {
      event.preventDefault();
      if (aktivtTrin > 0) {
        aktivtTrin--;
        visTrin();
      }
    });
  });

  // Kør med det samme, så trin 1 er aktivt og 2-4 forbliver brune fra start
  visTrin();
</script>

<!-- ============================================================ -->
<!-- BOOKING-OVERSIGT - udfylder højre side + beregner pris       -->
<!-- ============================================================ -->
<script>
  // Finder felterne i trin 1 (det brugeren vælger)
  const aktivitetFelt = document.querySelector("#aktivitet") as HTMLSelectElement;
  const varighedFelt = document.querySelector("#tid") as HTMLSelectElement;
  const antalFelt = document.querySelector("#amount") as HTMLInputElement;

  // Finder spans i oversigten hvor værdierne skal vises
  const visAktivitet = document.querySelector("#vis-aktivitet") as HTMLElement;
  const visVarighed = document.querySelector("#vis-varighed") as HTMLElement;
  const visAntal = document.querySelector("#vis-antal") as HTMLElement;
  const visTotal = document.querySelector("#vis-total") as HTMLElement;

  // Prisliste (opslagstabel) - pris per person per time for hver aktivitet
  const priser: Record<string, number> = {
    Paintball: 375,
    Bowtag: 300,
    Bueskydning: 300,
    Dødningbold: 300,
    Forhindringsbane: 300,
    Hardball: 300,
    "Kæmpe Bordfodbold": 300,
    Lasertag: 300,
    Megaboksning: 300,
    Spydkast: 300,
    Stokkekamp: 300,
    Sumobrydning: 300,
  };

  // Opdaterer hele oversigten - køres hver gang et felt ændres.
  // Læser værdierne med .value og skriver dem ud med .textContent.
  // Beregner til sidst prisen som: pris per person × antal deltagere × antal timer.
  function opdaterOversigt() {
    visAktivitet.textContent = aktivitetFelt.value;
    visVarighed.textContent = varighedFelt.value;
    visAntal.textContent = antalFelt.value;

    const prisPerPerson = priser[aktivitetFelt.value] || 0; // pris, ellers 0 hvis ingen findes
    const antal = Number(antalFelt.value) || 0; // tekst om til tal
    const timer = varighedFelt.value === "2 timer" ? 2 : 1; // 2 timer = 2, ellers 1

    // OBS! Fjern "* antal" hvis prisen IKKE skal regnes pr. person
    const total = prisPerPerson * antal * timer;
    visTotal.textContent = String(total);
  }

  // Lytter på ændringer i felterne. "change" til dropdowns, "input" til tekstfelt.
  aktivitetFelt.addEventListener("change", opdaterOversigt);
  varighedFelt.addEventListener("change", opdaterOversigt);
  antalFelt.addEventListener("input", opdaterOversigt);

  // AUTO-UDFYLD FRA URL - hvis man kom fra et aktivitetskort (?aktivitet=...)
  // Vi kalder opdaterOversigt() direkte, da funktionen er lige ved hånden her.
  const params = new URLSearchParams(window.location.search);
  const valgtAktivitet = params.get("aktivitet"); // henter værdien efter "aktivitet="
  if (valgtAktivitet) {
    aktivitetFelt.value = valgtAktivitet; // sæt dropdown'en til aktiviteten
    opdaterOversigt(); // opdater oversigt + pris med det samme
  }
</script>

<!-- ============================================================ -->
<!-- DATO & TID I OVERSIGTEN                                      -->
<!-- ============================================================ -->
<script>
  // Find kalenderen og de to tidsfelter
  const kalender = document.querySelector("calendar-date") as any;
  const timeFelt = document.querySelector("#time") as HTMLInputElement;
  const minutterFelt = document.querySelector("#minutter") as HTMLInputElement;

  // Find oversigtens span hvor dato + tid skal vises
  const visTidspunkt = document.querySelector("#vis-tidspunkt") as HTMLElement;

  // Samler dato + klokkeslæt og viser det i oversigten
  function opdaterDato() {
    const dato = kalender.value; // fx "2026-05-20"
    const time = timeFelt.value; // fx "12"
    const minutter = minutterFelt.value; // fx "30"

    // Byg teksten: vis dato, og klokkeslæt hvis begge felter er udfyldt
    let tekst = dato;
    if (time !== "" && minutter !== "") {
      tekst = tekst + " kl. " + time + ":" + minutter;
    }

    visTidspunkt.textContent = tekst;
  }

  // Lyt på ændringer
  kalender.addEventListener("change", opdaterDato); // når man vælger en dato
  timeFelt.addEventListener("input", opdaterDato); // mens man skriver timer
  minutterFelt.addEventListener("input", opdaterDato); // mens man skriver minutter
</script>

<!-- ============================================================ -->
<!-- TILFØJ FLERE AKTIVITETER - kloner skabelonen ved klik        -->
<!-- ============================================================ -->
<script>
  const addButton = document.querySelector("#addActivity") as HTMLButtonElement;
  const wrapper = document.querySelector("#activitiesWrapper") as HTMLElement;
  const template = document.querySelector("#activityTemplate") as HTMLTemplateElement;

  addButton.addEventListener("click", () => {
    const clone = template.content.cloneNode(true); // laver en kopi af skabelonen
    wrapper.appendChild(clone); // tilføjer kopien i wrapperen
  });
</script>

<!-- ============================================================ -->
<!-- VIS/SKJUL SPISNINGS-FELTER - styret af checkboxen            -->
<!-- ============================================================ -->
<script>
  const tilkobSpisning = document.querySelector("#tilkobSpisning") as HTMLInputElement;
  const spisningFields = document.querySelector("#spisningFields") as HTMLElement;

  tilkobSpisning?.addEventListener("change", () => {
    // Vis felterne hvis checkboxen er sat, skjul dem ellers
    spisningFields.classList.toggle("hidden", !tilkobSpisning.checked);
    spisningFields.classList.toggle("flex", tilkobSpisning.checked);
  });
</script>

<!-- Åbner dialog -->
<script is:client>
  if (window.location.hash === "#terms") {
    document.getElementById("terms")?.showModal();
  }
</script>