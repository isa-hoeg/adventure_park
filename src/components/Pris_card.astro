---
const { title1, tid, tid2, info1, info2, info3, badge, pris, pris2, bg, height, class: extraClass = "" } = Astro.props;
import Heading from "./Heading.astro";
import Text from "./Text.astro";
import Link from "./Link.astro";
import '../styles/tailwind.css';
---

<article
  class:list={[
    "flex flex-col justify-between w-full rounded-lg p-8 intersect:animate-fade-left animate-once animate-duration-[2000ms]", bg, height]}>
    <div class="bg-neongreen-400 px-2 py-1 rounded-md w-fit">
        <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger">{badge}</Heading>
    </div>
    <div class=" flex flex-col gap-6">
        <div class="flex flex-col justify-center items-center gap-2">
            <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger">{title1}</Heading>
            <div class="flex flex-row gap-2">
                <Text teksttype="brødtekst-body" stylingclasses="text-stronger lg:pt-3">Fra</Text>
                <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-stronger">{pris}</Heading>
            </div>
        </div>
        <div class="flex flex-row justify-center items-center gap-6">
            <div class="flex flex-col gap-2 justify-center items-center">
                <div class="flex flex-row gap-2">
                    <img src="/icons/ur_dark.svg" alt="ur">
                    <Text teksttype="brødtekst-body" stylingclasses="text-stronger">{tid}</Text>
                </div>
                <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger">{pris}</Heading>
            </div>
            <div class="flex flex-col gap-2 justify-center items-center">
                <div class="flex flex-row gap-2">
                    <img src="/icons/ur_dark.svg" alt="ur">
                    <Text teksttype="brødtekst-body" stylingclasses="text-stronger">{tid2}</Text>
                </div>
                <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger">{pris2}</Heading>
            </div>
        </div>
        <div class="border-2 border-stroke-dark w-full"></div>
        <div class="flex flex-col gap-2">
            <div class="flex flex-row gap-2">
                <img src="/icons/checkcircle.svg" alt="check">
                <Text teksttype="brødtekst" stylingclasses="text-stronger">{info1}</Text>
            </div>
            <div class="flex flex-row gap-2">
                <img src="/icons/checkcircle.svg" alt="check">
                <Text teksttype="brødtekst" stylingclasses="text-stronger">{info2}</Text>
            </div>
            <div class="flex flex-row gap-2">
                <img src="/icons/checkcircle.svg" alt="check">
                <Text teksttype="brødtekst" stylingclasses="text-stronger">{info3}</Text>
            </div>
        </div>
    </div>
    <Link href="/booking" variant="primary" size="large">book</Link>
</article>