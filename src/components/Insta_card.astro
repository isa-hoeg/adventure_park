---
const { likes, comments, caption, img, class: extraClass = "" } = Astro.props;
import Heading from "./Heading.astro";
import Text from "./Text.astro";
import "../styles/tailwind.css";
---

<a href="https://www.instagram.com/adventurepark.dk/" target="_blank" aria-label="Instagram" class="group relative block overflow-hidden rounded-lg w-[150px] md:w-[260px] lg:w-[280px] aspect-[4/5] flex-shrink-0">
  <img src={img} alt="" width="800" height="1000" loading="lazy" decoding="async" class="w-full h-full object-cover rounded-lg"/>
  <div class="bg-bg-black-800/90 hidden
                p-4
                flex-col
                justify-center
                items-center
                gap-4
                lg:flex
                lg:absolute
                lg:inset-0
                lg:opacity-0
                lg:group-hover:opacity-100
                lg:transition-opacity
                lg:duration-300">

    <div class="flex flex-row gap-6">
      <div class="flex flex-row gap-2 items-center">
        <img src="/icons/Heart.svg" alt="heart" class="w-7" />
        <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-weakest">{likes}</Heading>
      </div>
      <div class="flex flex-row gap-2 items-center">
        <img src="/icons/comment.svg" alt="comment" class="w-7" />
        <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-weakest">{comments}</Heading>
      </div>
    </div>
    <Text tekstype="brødtekst" stylingclasses="text-weakest text-center">{caption}</Text>
  </div>
</a>
