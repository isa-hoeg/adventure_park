<script>
  let currentStep = 1;

  const nextButton = document.querySelector("#nextStep");
  const steps = document.querySelectorAll(".progress-step");

  function updateProgress() {
    steps.forEach((step) => {
      const stepNumber = Number(step.dataset.step);
      const circle = step.querySelector(".step-circle");
      const number = step.querySelector(".step-number");
      const label = step.querySelector(".step-label");

      if (stepNumber < currentStep) {
        circle.className = "step-circle bg-neongreen-400 border-2 border-neongreen-400 w-14 h-14 rounded-full flex items-center justify-center";
        number.textContent = "✓";
        number.className = "step-number text-stronger font-bold";
        label.className = "step-label text-stronger";
      } else if (stepNumber === currentStep) {
        circle.className = "step-circle bg-bg-beige-200 border-2 border-stroke-primary-accent w-14 h-14 rounded-full flex items-center justify-center";
        number.textContent = stepNumber;
        number.className = "step-number text-stronger";
        label.className = "step-label text-stronger";
      } else {
        circle.className = "step-circle bg-bg-beige-400 border border-bg-beige-500 w-14 h-14 rounded-full flex items-center justify-center";
        number.textContent = stepNumber;
        number.className = "step-number text-weak";
        label.className = "step-label text-weak";
      }
    });
  }

  nextButton?.addEventListener("click", () => {
    if (currentStep < 4) {
      currentStep++;
      updateProgress();
    }
  });
</script>
