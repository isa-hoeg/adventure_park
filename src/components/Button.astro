---
// Henter parametrene fra Astro.props
const { variant= "primary", size = "medium", ...rest } = Astro.props; 
 
//Definer den styling (Tailwind classes, der gør sig gældende for alle knapper)
const buttonStyling = "px-4 py-2"; 
 
//Definer den styling (Tailwind classes), der gør sig gældende for de forskellige varianter 
const variantClasses = {
"primary": "flex border-1 justify-center border-stroke-dark bg-primary-accent font-heading font-semibold text-stronger hover:bg-primary hover:text-neongreen-400", /* border-primary-500 */
"secondary": "flex border-1 justify-center border-stroke-dark bg-secondary-beige font-heading font-semibold text-stronger hover:bg-secondary", /* border-secondary-500 */
};
 
//Definer den styling (Tailwind classes), der gør sig gældende for de forskelligeog størrelser.
const sizeClasses = {
"small": "text-xs lg:text-sm", //button i card
"large": "text-lg lg:text-2xl", //button i mobil og desktop
};
---
<!--Sæt classes for den pågældende knap sammen ved hjælp af Astros class:list -->
<button {...rest} class:list={[buttonStyling, variantClasses[variant], sizeClasses[size]]}><slot /></button>