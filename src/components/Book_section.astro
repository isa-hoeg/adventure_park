---
import Heading from "./Heading.astro";
import Link from "./Link.astro";

const {heading="", linktext="", bg, linkvariant} = Astro.props;
---

<book_section class:list={["flex flex-col gap-8 py-10 lg:py-20 px-20 items-center", bg]}>
        <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-strongest text-center">{heading}</Heading>
        <Link href=/booking variant={linkvariant} size="large" stylingclasses="w-fit">{linktext}</Link>
</book_section>