---
// Henter parametrene fra Astro.props
const {
  href = "#",
  target = "_self",
  variant = "textlink",
  size = "default",
  class: extraClass = "",
  stylingclasses = "",
  onclick = "",
} = Astro.props as {
  href?: string;
  target?: string;
  variant?: "textlink" | "primary" | "secondary" | "tertiary";
  size?: "default" | "small" | "large";
  class?: string;
  stylingclasses?: string;
  onclick?: string;
};

//Definer den styling (Tailwind classes, der gør sig gældende for alle links
const linkStyling = "";

//Definer den styling (Tailwind classes), der gør sig gældende for de forskellige varianter
const variantClasses = {
  textlink: "text-weakest hover:text-neongreen-400 font-extralight",
  primary: "flex border-1 justify-center px-4 py-2 border-stroke-dark bg-primary-accent font-heading font-semibold text-stronger hover:bg-primary hover:text-neongreen-400 uppercase",
  secondary: "flex border-1 justify-center px-4 py-2 border-stroke-dark bg-secondary-beige font-heading font-semibold text-stronger hover:bg-secondary uppercase",
  tertiary: "flex border-1 justify-center px-4 py-2 border-stroke-dark bg-tertiary font-heading font-semibold text-stronger hover:bg-secondary uppercase",
};

//Definer den styling (Tailwind classes), der gør sig gældende for de forskellige størrelser.
const sizeClasses = {
  default: "",
  small: "text-[10px] lg:text-sm",
  large: "text-lg lg:text-2xl",
  textlink: "text-base lg:text-xl",
};
---

<!--Sæt classes for den pågældende knap sammen ved hjælp af Astros class:list -->
<a href={href} target={target} onclick={onclick} class:list={[linkStyling, variantClasses[variant], sizeClasses[size], extraClass, stylingclasses]}>
  <slot />
</a>
