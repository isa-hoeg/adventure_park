---
const { spørgsmål, svar } = Astro.props;
import Heading from "./Heading.astro";
import Text from "./Text.astro";
---

<div x-data="{ open: false }" class="border-b border-stroke-dark">
  <button x-on:click="open = !open" class="w-full flex justify-between items-center py-4 px-2 text-left hover:cursor-pointer">
    <Heading htmlheading="h3" size="small" font="heading" stylingclasses="text-stronger">{spørgsmål}</Heading>
    <span class="text-2xl">⌄</span>
  </button>
  <div x-show="open" x-transition class="px-2 pb-4">
    <Text teksttype="brødtekst-body" stylingclasses="text-stronger">{svar}</Text>
  </div>
</div>


