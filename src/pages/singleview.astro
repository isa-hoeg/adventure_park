---
import MainLayout from "../layouts/MainLayout.astro";
import Pris_card from "../components/Pris_card.astro";
import Heading from "../components/Heading.astro";
import Link from "../components/Link.astro";
import Text from "../components/Text.astro";
import Fold_ud_card from "../components/Fold_ud_card.astro";
import Book_section from "../components/Book_section.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<MainLayout title="Paintball">
     <div class="progress-bar h-4 z-110 fixed w-full bg-[url('/img/progress_bar.svg')] left-0 origin-top-left top-0 right-0"></div>
  <main class="">
    <!-- START PÅ HERO SEKTION -->
    <section class="bg-bg-army-700 relative h-150 w-full bg-cover bg-[77%_center] bg-[url('/img/hero_paintball_bg.webp')] pt-20 flex flex-col justify-between lg:pt-40 lg:h-157">
      <!-- BREADCRUMBS -->
      <!-- Absolute gør, at breadcrumbs placeres oven på hero-billedet
       og ikke påvirkes af sectionens pt-20 -->
    <div class="absolute top-8 lg:top-10 left-20 z-20">
     <Breadcrumbs
        textColor="text-weakest"
        homeIcon="/icons/home_light.svg"
        items={[
        { label: "Forside", href: "/" },
        { label: "Aktiviteter", href: "/alle_aktiviteter" },
        { label: "Paintball", href: "/singleview" }
        ]}
      />
    </div>
      <div class="flex flex-col justify-center items-center gap-7">
        <Heading htmlheading="h1" size="large" font="display" stylingclasses="text-weakest intersect:animate-fade-down animate-once animate-duration-[2000ms]">Paintball</Heading>
        <Link href="/booking" variant="primary" size="large" stylingclasses="w-fit">book</Link>
      </div>
      <img src="/img/hero_paintball_overlay.webp" alt="Paintball overlay" class="absolute top-47 left-4 scale-102 z-0 origin-top lg:scale-31 lg:top-47 lg:left-77" />
      <div class="z-20 grid grid-cols-2 gap-6 px-10 bg-bg-beige-opacity py-5 lg:flex lg:flex-row lg:justify-between lg:px-60 lg:py-10 intersect:animate-fade-up animate-once animate-duration-[2000ms]">
        <div class="flex flex-row gap-2">
          <img src="/icons/personer_ikon_neon.svg" alt="ikon personer" class="w-7" />
          <Heading htmlheading="h3" size="small" font="heading" stylingclasses="text-stronger">8-24 pers</Heading>
        </div>
        <div class="flex flex-row gap-2">
          <img src="/icons/ur_ikon_neon.svg" alt="ikon personer" class="w-7" />
          <Heading htmlheading="h3" size="small" font="heading" stylingclasses="text-stronger">1-2 timer</Heading>
        </div>
        <div class="flex flex-row gap-2">
          <img src="/icons/plus_ikon_neon.svg" alt="ikon personer" class="w-7" />
          <Heading htmlheading="h3" size="small" font="heading" stylingclasses="text-stronger">16 år</Heading>
        </div>
        <div class="flex flex-row gap-2">
          <img src="/icons/penge_ikon_neon.svg" alt="ikon personer" class="w-5" />
          <Heading htmlheading="h3" size="small" font="heading" stylingclasses="text-stronger">fra 300 kr</Heading>
        </div>
      </div>
    </section>
    <!-- SLUT PÅ HERO SEKTION -->

    <!-- START PÅ OM PAINTBALL I AP SEKTION -->
    <section class="bg-bg-beige-200 grid grid-cols-1 px-8 gap-10 lg:grid-cols-2 lg:items-center py-20">
      <div class="flex flex-col gap-6">
        <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-stronger intersect:animate-fade-right animate-once animate-duration-[2000ms]">paintball i adventure park</Heading>
        <Text teksttype="brødtekst-body" stylingclasses="text-stronger">Velkommen til Adventure Parks varierede udvalg af paintball baner. Paintball er en fantastisk sjov aktivitet, der kan spilles på mange niveauer. Derfor har vi valgt at have et varieret udvalg af paintball scenarier der kan tilfredsstille et hvert ønske.</Text>
        <Text teksttype="brødtekst-body" stylingclasses="text-stronger">Vi spiller med kvalitets udstyr fra Tippmann og med kvalitet paintballs fra en af verdens førende producenter. Når I spiller paintball i Adventure Park, er I altid sikre på at få udleveret rent og nyvasket udstyr (sikkerhedsmaske og heldragt). </Text>
        <Text teksttype="brødtekst-body" stylingclasses="text-stronger">Vi sætter en ære i at vores kunder forlader os med en god oplevelse.</Text>
      </div>
      <div>
        <img src="/img/paintball1.webp" alt="paintball" />
      </div>
    </section>
    <!-- SLUT PÅ OM PAINTBALL I AP SEKTION -->

    <!-- START PÅ PRIS SEKTION -->
    <section class="flex flex-col px-10 py-20 lg:px-20 bg-bg-black-800 gap-8">
      <div class="flex flex-col items-center">
        <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-weakest intersect:animate-fade-up animate-once animate-duration-[2000ms]">Priser pr. person</Heading>
      </div>
      <div class="grid grid-cols-1 gap-6 justify-center items-center lg:grid-cols-3">
        <Pris_card height="h-115 lg:h-130" bg="bg-bg-beige-200" title1="spil 200 kugler" pris="300 kr" pris2="350 kr" tid="1 time" tid2="2 timer" info1="3oo kugler" info2="Spiludstyr" info3="Instruktion" />
        <Pris_card badge="Mest populære" height="h-115 lg:h-145" bg="bg-bg-coral-400" title1="spil 300 kugler" pris="375 kr" pris2="400 kr" tid="1 time" tid2="2 timer" info1="3oo kugler" info2="Spiludstyr" info3="Instruktion" />
        <Pris_card height="h-115 lg:h-130" bg="bg-bg-beige-200" title1="spil fri antal kugler" pris="400 kr" pris2="500 kr" tid="1 time" tid2="2 timer" info1="Fri antal kugler" info2="Spiludstyr" info3="Instruktion" />
      </div>
      <div class="flex flex-row gap-2 bg-bg-beige-200 p-4 rounded-lg items-center lg:gap-4 lg:p-8 intersect:animate-fade-right animate-once animate-duration-[2000ms]">
        <img src="/icons/procent_ikon.svg" alt="" />
        <Text teksttype="brødtekst-body">Ved 20+ deltagere tilbyder vi 10% rabat på vejledende priser.</Text>
      </div>
      <!-- SLUT PÅ PRIS SEKTION -->
    </section>

    <!-- START PÅ OM SPILLET -->
    <section class="bg-[url('/img/paintball_bane_mobil.webp')] bg-cover h-300 w-full lg:h-150 lg:bg-[url('/img/paintball_bane.webp')]">
      <div class="bg-bg-army-opacity p-10 grid grid-cols-1 lg:w-190 lg:h-full items-center">
        <div class="flex flex-col gap-6">
          <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-weakest intersect:animate-fade-up animate-once animate-duration-[2000ms]">om spillet</Heading>
          <Text teksttype="brødtekst-body" stylingclasses="text-weakest">Paintball er et holdspil, hvor det grundlæggende gælder om at fjerne modspillere fra banen, ved at markere dem med en farvemarkering.</Text>
          <Text teksttype="brødtekst-body" stylingclasses="text-weakest">Måske er der lagt missioner ind i spillet, som holdet skal samarbejde om at fuldføre. Når alle modstandere er markeret, eller når missionen er fuldført, er spillet færdigt og alle gør klar til et nyt spil.</Text>
          <Text teksttype="brødtekst-body" stylingclasses="text-weakest">Alle spillere er udstyret med en paintballmarkør, en sikkerhedsmaske der dækker hele ansigtet og en heldragt. Der spilles i 2 eller flere hold på et afgrænset område (bane), der er tilpasset antallet af deltagere.</Text>
        </div>
      </div>
    </section>
    <!-- SLUT PÅ OM SPILLET -->

    <section class="bg-bg-beige-200 p-8 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:py-20">
      <div class="flex flex-col gap-6 lg:order-2">
        <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-stronger intersect:animate-fade-up animate-once animate-duration-[2000ms]">praktisk info:</Heading>
        <ul class="list-disc pl-4 intersect:animate-fade-right animate-once animate-duration-[2000ms]">
          <li>
            <div class="flex flex-col">
              <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger">deltagere:</Heading>
              <Text teksttype="brødtekst-body" stylingclasses="text-stronger">8–24 personer (større grupper efter aftale)</Text>
            </div>
          </li>
          <li>
            <div class="flex flex-col pt-4">
              <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger">Varighed:</Heading>
              <Text teksttype="brødtekst-body" stylingclasses="text-stronger">Mellem 1–2 timer</Text>
            </div>
          </li>
          <li>
            <div class="flex flex-col pt-4">
              <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger">Alder:</Heading>
              <Text teksttype="brødtekst-body" stylingclasses="text-stronger">Minimum 16 år</Text>
            </div>
          </li>
          <li>
            <div class="flex flex-col pt-4">
              <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger ">Udstyr inkluderet:</Heading>
              <Text teksttype="brødtekst-body" stylingclasses="text-stronger">Sikkerhedsmaske, heldragt og paintballmarkør</Text>
            </div>
          </li>
          <li>
            <div class="flex flex-col pt-4">
              <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger">Kugler:</Heading>
              <Text teksttype="brødtekst-body" stylingclasses="text-stronger">Vælg mellem 200, 300, 400 eller fri antal kugler pr. person</Text>
            </div>
          </li>
          <li>
            <div class="flex flex-col pt-4">
              <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger">Oplevelse:</Heading>
              <Text teksttype="brødtekst-body" stylingclasses="text-stronger">Holdspil med missioner og varierede baner i naturen</Text>
            </div>
          </li>
        </ul>
        <div class="flex flex-col items-center">
          <Link href="#" variant="secondary" size="large" stylingclasses="w-fit">HER FINDER DU OS</Link>
        </div>
      </div>
      <div>
        <img src="/img/paintball2.webp" alt="paintball close up" />
      </div>
    </section>

    <!-- ============================================== -->
    <!-- SPISNING SEKTION - kort med menuvalg           -->
    <!-- ============================================== -->
    <!-- 
    bg-bg-beige-400          = beige baggrund
    py-10                    = padding 40px top/bund på mobil
    px-8                     = padding 32px i siderne
    lg:py-20                 = padding 80px top/bund på desktop
  -->
    <div class="bg-bg-beige-400 py-10 px-8 lg:py-20">
      <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-stronger intersect:animate-fade-left animate-once animate-duration-[2000ms]">Spisning i parken</Heading>

      <!-- Intro-tekst - py-4 = padding top/bund, lg:w-1/2 = halv bredde på desktop -->
      <Text teksttype="brødtekst-body" stylingclasses="text-stronger py-4 lg:w-1/2">Spisning i parken er et tilkøb, som kun kan vælges sammen med en booket aktivitet. Det er samtidig helt i orden at medbringe egen mad.</Text>

      <!-- WRAPPER FOR KORTENE - horisontal scroll både mobil og desktop -->
      <!-- 
      flex flex-row             = kortene ligger ved siden af hinanden (også på mobil)
      gap-4                     = 16px afstand mellem kortene
      items-stretch             = alle kort strækkes til samme højde
      overflow-x-auto           = horisontal scroll når der ikke er plads
    -->
      <div class="flex flex-row gap-4 items-stretch overflow-x-auto intersect:animate-fade-up animate-once animate-duration-[2000ms]">
        <!-- FOLD UD KORTENE - hvert kort kan klikkes for at åbne/lukke -->
        <!-- 
        accentColor="#ecff37"       = gul streg (neongrøn-400)
        stregHøjde="h-20"           = streg er 80px høj
        højde="h-[380px]"           = kort er 380px højt
        mobilBredde="w-[340px]"     = 340px bredt på mobil
        bredde="lg:w-[340px]"       = 340px bredt på desktop (det åbne kort bliver 500px - styret i komponentet)
        open={true}                 = dette kort starter åbent som standard
      -->
        <Fold_ud_card accentColor="#ecff37" stregHøjde="h-20" højde="h-[380px]" mobilBredde="w-[340px]" bredde="lg:w-[340px]" billede="/img/mad.webp" titel="Kyllingburger menu" href="/menu" open={true}>
          <Text stylingclasses="text-stronger">Pulled chicken med coleslaw i en burgerbolle og ovnstegte kartofler.</Text>
          <!-- list-disc = punkttegn, pl-5 = padding-left 20px, mt-4 = margin-top 16px -->
          <ul class="list-disc pl-5 mt-4">
            <li><Text stylingclasses="text-stronger">I samler selv burgerne.</Text></li>
            <li><Text stylingclasses="text-stronger">Kan serveres inde eller ude.</Text></li>
            <li><Text stylingclasses="text-stronger">Vi klarer oprydningen.</Text></li>
          </ul>
          <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger mt-4 mb-5">180 kr. pr. person</Heading>
        </Fold_ud_card>

        <Fold_ud_card accentColor="#ecff37" stregHøjde="h-20" højde="h-[380px]" mobilBredde="w-[340px]" bredde="lg:w-[340px]" billede="/img/mad_1.webp" titel="Okseburger menu" href="/menu">
          <Text stylingclasses="text-stronger">Saftig okseburger med salat, ost og hjemmelavet dressing i sprødt brød.</Text>
          <ul class="list-disc pl-5 mt-4">
            <li><Text stylingclasses="text-stronger">Vi griller bøffer og anretter som buffet.</Text></li>
            <li><Text stylingclasses="text-stronger">I samler selv burgerne.</Text></li>
            <li><Text stylingclasses="text-stronger">Vi klarer oprydningen.</Text></li>
          </ul>
          <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger mt-4 mb-5">200 kr. pr. person</Heading>
        </Fold_ud_card>

        <Fold_ud_card accentColor="#ecff37" stregHøjde="h-20" højde="h-[380px]" mobilBredde="w-[340px]" bredde="lg:w-[340px]" billede="/img/mad_2.webp" titel="Sandwich & frugt" href="/menu">
          <Text stylingclasses="text-stronger">Frisklavede sandwich med fyld efter ønske, serveret med sæsonens frugt.</Text>
          <ul class="list-disc pl-5 mt-4">
            <li><Text stylingclasses="text-stronger">Vælg mellem kylling, skinke eller vegetar.</Text></li>
            <li><Text stylingclasses="text-stronger">Anrettes pænt på fade.</Text></li>
            <li><Text stylingclasses="text-stronger">Nem og hurtig løsning.</Text></li>
          </ul>
          <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger mt-4 mb-5">120 kr. pr. person</Heading>
        </Fold_ud_card>

        <Fold_ud_card accentColor="#ecff37" stregHøjde="h-20" højde="h-[380px]" mobilBredde="w-[340px]" bredde="lg:w-[340px]" billede="/img/mad_3.webp" titel="Mix grill menu" href="/menu">
          <Text stylingclasses="text-stronger">Stor grillbuffet med varierede kødretter, salater og hjemmelavede saucer.</Text>
          <ul class="list-disc pl-5 mt-4">
            <li><Text stylingclasses="text-stronger">Vi griller på stedet.</Text></li>
            <li><Text stylingclasses="text-stronger">Buffet med flere salater og tilbehør.</Text></li>
            <li><Text stylingclasses="text-stronger">Vi klarer oprydningen.</Text></li>
          </ul>
          <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="text-stronger mt-4 mb-5">220 kr. pr. person</Heading>
        </Fold_ud_card>
      </div>
    </div>
    <!-- SLUT PÅ SPISNING -->

    <section>
      <Book_section 
      heading="Klar til at booke jeres aktivitet?" 
      linktext="Book paintball her"
      bg="bg-bg-coral-400"
      linkvariant="primary"/>
      
    </section>
  </main>
</MainLayout>

<script>
import { animate, stagger, inView, scroll } from "motion";

	/*Progress-baren/læseindikatoren */
	scroll( animate(".progress-bar", { scaleX: [0, 1] }));
</script>