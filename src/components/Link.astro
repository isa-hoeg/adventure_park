---
// Henter parametrene fra Astro.props
const {
  href="#",
  target="_self",
  variant= "textlink",
  size = "default",
  class: extraClass = ""
} = Astro.props;
 
//Definer den styling (Tailwind classes, der gør sig gældende for alle links
const linkStyling = ""; 
 
//Definer den styling (Tailwind classes), der gør sig gældende for de forskellige varianter 
const variantClasses = {
"textlink": "underline text-blue-500", /* text-primary-500 */
"primary": "flex border-1 justify-center px-4 py-2 border-stroke-dark bg-primary-accent font-heading font-semibold text-stronger hover:bg-primary hover:text-neongreen-400", /* border-primary-500 */
"secondary": "flex border-1 justify-center px-4 py-2 border-stroke-dark bg-secondary-beige font-heading font-semibold text-stronger hover:bg-secondary", /* border-secondary-500 */
"tertiary": "flex border-1 justify-center px-4 py-2 border-stroke-dark bg-tertiary-beige font-heading font-semibold text-stronger hover:bg-secondary" /* border-tertiary-500 */
};
 
//Definer den styling (Tailwind classes), der gør sig gældende for de forskelligeog størrelser.
const sizeClasses = {
"small": "text-xs lg:text-sm", //button i card
"large": "text-lg lg:text-2xl", //button i mobil og desktop
};
---
<!--Sæt classes for den pågældende knap sammen ved hjælp af Astros class:list -->
<a
  href={href}
  target={target}
  class:list={[
    linkStyling,
    variantClasses[variant],
    sizeClasses[size],
    extraClass
  ]}
>
  <slot />
</a>