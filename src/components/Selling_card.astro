---
import Heading from "./Heading.astro";
import Text from "./Text.astro";

const {url="#", icon="", iconalt="", title="", cardtekst=""} = Astro.props;
---
<selling_card class="relative bg-bg-beige-300 rounded-xl flex flex-col p-4 pt-15 lg:p-8 h-72 lg:h-78 flex-shrink-0">

    <!-- IKON -->
    <div class="absolute -top-10 left-1/2 -translate-x-1/2">
        <div class="rounded-full bg-bg-beige-500 p-5 lg:p-7">
            <img src={icon} alt={iconalt} class="w-10 h-10 lg:w-12 lg:h-12">
        </div>
    </div>

    <!-- INDHOLD -->
    <div class="flex flex-col gap-2 items-center text-center lg:pt-12">
        <Heading htmlheading="h3" size="small" font="heading" stylingclasses="text-stronger">
            {title}
        </Heading>

        <Text teksttype="brødtekst-card" stylingclasses="text-stronger">
            {cardtekst}
        </Text>
    </div>

</selling_card>