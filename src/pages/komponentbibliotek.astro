---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Link from "../components/Link.astro";
import Button from "../components/Button.astro";
import Aktivitet_card from "../components/Aktivitet_card.astro";
import Insta_card from "../components/Insta_card.astro";
import Pris_card from "../components/Pris_card.astro";
import Map from "../components/Map.astro";
import Anmeldelse_card from "../components/Anmeldelse_card.astro";
import ArrowButton from "../components/ArrowButton.astro";
import Book_section from "../components/Book_section.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FAQCard from "../components/FAQ_card.astro";
import Fold_ud_card from "../components/Fold_ud_card.astro";
import Kategori_card from "../components/Kategori_card.astro";
import Selling_card from "../components/Selling_card.astro";
---
<MainLayout title="Titel">
	<main class="container p-4 flex flex-col gap-10">
		<Heading htmlheading="h1" size="large">Komponentbibliotek</Heading>
        <Text stylingclasses="italic">Her kan du finde alle de komponenter, der er brugt i dette projekt.</Text>
        <hr class="my-4" />
         <!-- start på typografi -->
        <section class="">
            <Heading htmlheading="h2" size="medium" stylingclasses="py-4">Typografi & ovesrkrifter</Heading>
            <Text>Her kan du finde alle de komponenter, der er brugt i dette projekt.</Text>
            <Heading htmlheading="h1" size="display" font="display" stylingclasses="py-4">DISPLAY, BOLDONSE</Heading>
            <Heading htmlheading="h1" size="large" font="display" stylingclasses="py-4">H1, BOLDONSE</Heading>
            <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="py-4">H2, OSWALD</Heading>
            <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">H3, OSWALD</Heading>
            <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="py-4">H4, OSWALD</Heading>
            <Text teksttype="brødtekst">
            Her er en sektion brødtekst: Lorem ipsum dolor, sit amet consectetur adipisicing elit. Ullam dolorem doloremque commodi eaque quisquam quasi recusandae veniam. Corporis totam <Link href="#">Default link: </Link> reiciendis quibusdam ratione iure aut, numquam tenetur voluptatem exercitationem sequi enim!
            </Text>
            <Text teksttype="konsultativ">
            Her en sektion konsultativ tekst: Lorem ipsum dolor, sit amet consectetur adipisicing elit. Ullam dolorem doloremque commodi eaque quisquam quasi recusandae veniam. Corporis totam reiciendis quibusdam ratione iure aut, numquam tenetur voluptatem exercitationem sequi enim!
            </Text>
            <Text teksttype="brødtekst" stylingclasses="italic">
            Her er en sektion brødtekst med ekstra css: Lorem ipsum dolor, sit amet consectetur adipisicing elit. Ullam dolorem doloremque commodi eaque quisquam quasi recusandae veniam. Corporis totam <Link href="#">Default link: </Link> reiciendis quibusdam ratione iure aut, numquam tenetur voluptatem exercitationem sequi enim!
            </Text>
        </section>
        <!-- slut på typografi -->
        <hr class="my-4" />
        <!-- Link komponent instanser -->
        <section>
            <Heading htmlheading="h2" size="medium">Links</Heading>
            <Text teksttype="brødtekst"><Link href="#">Default link: </Link>Default linket er en del af en tekst, og burde gerne fungere som et <Link href="#">link</Link> i en paragraf.</Text>
            <Text><Link href="#" variant="primary" size="large">LINK VARIANT: PRIMARY SIZE LARGE</Link></Text>
            <Text><Link href="#" variant="primary" size="small">LINK VARIANT: PRIMARY SIZE SMALL</Link></Text>
            <Text><Link href="#" variant="secondary" size="large">LINK VARIANT: SECONDARY SIZE LARGE</Link></Text>
            <Text><Link href="#" variant="secondary" size="small">LINK VARIANT: SECONDARY SIZE SMALL</Link></Text>
            <Text><Link href="#" variant="tertiary" size="large">LINK VARIANT: TERTIARY SIZE LARGE</Link></Text>
            <Text><Link href="#" variant="tertiary" size="small">LINK VARIANT: TERTIARY SIZE SMALL</Link></Text>
        </section>
        <!-- Slut på Link komponent instanser -->
         <hr class="my-4" />
        <!-- Buttons komponent instanser -->
        <section>
            <Heading htmlheading="h2" size="medium">Buttons</Heading>
            <Text><Button href="#" variant="primary" size="large">LINK VARIANT: PRIMARY SIZE LARGE</Button></Text>
            <Text><Button href="#" variant="primary" size="small">LINK VARIANT: PRIMARY SIZE SMALL</Button></Text>
            <Text><Button href="#" variant="secondary" size="large">LINK VARIANT: SECONDARY SIZE LARGE</Button></Text>
            <Text><Button href="#" variant="secondary" size="small">LINK VARIANT: SECONDARY SIZE SMALL</Button></Text>
        </section>
        <!-- Slut på Buttons komponent instanser -->
         <hr class="my-4" />
         <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="py-4">UI Komponenter</Heading>
           <section >
            <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">aktivitetscard</Heading>
            <div class="grid grid-cols-2 gap-2">
                <Aktivitet_card
                title="Sumobrydning"
                personer="+2 personer"
                tid="1 time"
                img="/sumobrydning.webp"
                pris="FRA 2500"
                badge="LEG"
                />
                <Aktivitet_card
                title="Sumobrydning"
                personer="+2 personer"
                tid="1 time"
                img="/sumobrydning.webp"
                pris="FRA 2500"
                badge="LEG"
                />
            </div>
        </section>
        <section >
            <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">Some cards</Heading>
            <div class="grid grid-cols-2 gap-2 lg:flex">
            <Insta_card
            likes="254"
            comments="5"
            caption="Kom ud i naturen og mærk suset🌿 Hos Adventure Park danner omgivelserne rammen for oplevelser, du ikke glemmer."
            img="/img/Instapost1.webp"
            />
            <Insta_card
            likes="254"
            comments="5"
            caption="Kom ud i naturen og mærk suset 🌿Hos Adventure Park danner omgivelserne rammen for oplevelser, du ikke glemmer."
            img="/img/instapost2.webp"
            />
            <Insta_card
            likes="254"
            comments="5"
            caption="Kom ud i naturen og mærk suset 🌿Hos Adventure Park danner omgivelserne rammen for oplevelser, du ikke glemmer."
            img="/img/instapost3.webp"
            />
            <Insta_card
            likes="254"
            comments="5"
            caption="Kom ud i naturen og mærk suset 🌿Hos Adventure Park danner omgivelserne rammen for oplevelser, du ikke glemmer."
            img="/img/instapost4.webp"
            />
            </div>
        </section>
        <section class="flex flex-col gap-8">
            <Heading htmlheading="h3" size="small" font="heading" stylingclasses="text-stronger intersect:animate-fade-up animate-once animate-duration-[2000ms]">Pris cards</Heading>
            <div class="grid grid-cols-1 gap-6 justify-center items-center md:grid-cols-3 md:gap-4 lg:grid-cols-3">
                <Pris_card height="h-115 lg:h-130" bg="bg-bg-beige-200" title1="spil 200 kugler" pris="300 kr" pris2="350 kr" tid="1 time" tid2="2 timer" info1="3oo kugler" info2="Spiludstyr" info3="Instruktion" />
                <Pris_card badge="Mest populære" height="h-115 md:h-130 lg:h-145" bg="bg-bg-coral-400" title1="spil 300 kugler" pris="375 kr" pris2="400 kr" tid="1 time" tid2="2 timer" info1="3oo kugler" info2="Spiludstyr" info3="Instruktion" class="order-firs md:order-none lg:order-none" />
                <Pris_card height="h-115 lg:h-130" bg="bg-bg-beige-200" title1="spil fri antal kugler" pris="400 kr" pris2="500 kr" tid="1 time" tid2="2 timer" info1="Fri antal kugler" info2="Spiludstyr" info3="Instruktion" />
            </div>
        </section>
        
        <Map/>
        
        <section>
         <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">Selling Cards</Heading>   
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 lg:gap-x-8 gap-y-15 pt-10">
          <div class="intersect:animate-fade-up animate-once animate-duration-[2000ms]">
            <Selling_card icon="/icons/fleksibilitet.svg" iconalt="ikon for fleksibilitet" title="Åbningstider" cardtekst="Åbent efter aftale: Vi kan afvikle events inde og ude hele døgnet." />
          </div>

          <div class="intersect:animate-fade-down animate-once animate-duration-[2000ms]">
            <Selling_card icon="/icons/sikkerhed.svg" iconalt="ikon for sikkerhed" title="Sikkerhed" cardtekst="Alle vores aktiviteter er godkendt og alle kunder er forsikret gennem os." />
          </div>

          <div class="intersect:animate-fade-up animate-once animate-duration-[2000ms]">
            <Selling_card icon="/icons/erfaring.svg" iconalt="ikon for erfaring" title="Erfaring" cardtekst="Vi har udviklet og afholdt fornøjelses- og teambuildingevents i ca. 20 år." />
          </div>

          <div class="intersect:animate-fade-down animate-once animate-duration-[2000ms]">
            <Selling_card icon="/icons/kapacitet.svg" iconalt="ikon for kapacitet" title="Kapacitet" cardtekst="Vores udendørs park på 80.000 m² danner ramme om events for både små og store grupper." />
          </div>
        </div>
        </section>
        
        <section>
        <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">Fold ud Cards</Heading>  
        <Fold_ud_card stregHøjde="h-20" højde="h-[350px]" mobilBredde="w-[340px]" bredde="lg:w-[340px]" billede="/img/nyheder_1.webp" titel="Mystery Run" href="/nyheder" open={true}>
            <Text stylingclasses="text-stronger">Forestil dig spænding fra Escape Rooms – men udendørs. I bevæger jer fra sted til sted, mens I løser gåder, knækker koder samt optjener og stjæler point undervejs.</Text>
        </Fold_ud_card>
        </section>

        <section>
        <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">Anmeldelses Cards</Heading>  
        <Anmeldelse_card userimage="user1.svg" userimagealt="user bruger 1" username="Maria, 28 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/filled_star.svg" rating5="/icons/filled_star.svg" ratingsalt="" cardtekst1="Vi havde en fantastisk oplevelse hos Adventure Park! Min veninde skal giftes og elsker action, hvorfor vi valgte at holde hendes polterabend hos dem. Vi bookede 2 timers paintball, hvorefter vi tilkøbte parkens grill-menu, så vi ikke skulle finde et andet sted at spise. Super god service og gode faciliteter!" cardtekst2="Jeg vil i den grad anbefale parken til andre, der skal bruge en sjov gruppeaktivitet!" />
        </section>

        <section>
        <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">Arrow Button</Heading>  
        <ArrowButton></ArrowButton>
        </section>

        <section>
            <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">Book Section</Heading>  
            <Book_section heading="Klar til at booke jeres aktivitet?" linktext="Book paintball her" bg="bg-bg-coral-400" linkvariant="primary" href="/booking?aktivitet=Paintball" />
            <Book_section heading="Vil i spise i parken?" linktext="Se vores menu" bg="bg-bg-beige-400" linkvariant="tertiary" href="/praktisk_info#spisning"/>
        </section>

        <section>
        <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">Kategori Cards</Heading>  
        <div class="flex flex-col md:justify-center md:items-center lg:flex-row gap-4">
            <Kategori_card billede="/img/kategori_1.webp" titel="Firmaer" tag1="Samarbejde" tag2="Fællesskab" href="/alle_aktiviteter" />
            <Kategori_card billede="/img/kategori_2.webp" titel="Børn & Unge" tag1="Leg" tag2="Sjov" href="/alle_aktiviteter" />
            <Kategori_card billede="/img/kategori_3.webp" titel="Private" tag1="Fødselsdag" tag2="Polterabend" href="/alle_aktiviteter" />
        </div>
        </section>

        <section>
        <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">FAQ</Heading> 
        <FAQCard spørgsmål="Hvor fysisk krævende er aktiviteterne?" svar="Vores aktiviteter varierer i intensitet, men de fleste kræver et moderat niveau af fysisk aktivitet. Sværhedsgrad og tempo kan tilpasses jeres gruppe, så alle kan være med – uanset erfaring og niveau." />
        </section>

        <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">Breadcrumbs</Heading> 
        <div class=" py-4">
      <Breadcrumbs
        textColor="text-stronger"
        homeIcon="/icons/home.svg"
        items={[
          { label: "Forside", href: "/" },
          { label: "Aktiviteter", href: "/alle_aktiviteter" },
        ]}
      />
    </div>
    </main>
</MainLayout>

