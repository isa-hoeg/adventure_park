---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import Aktivitet_card from "../components/Aktivitet_card.astro";
import Book_section from "../components/Book_section.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<MainLayout title="Alle Aktiviteter">
  <main class="bg-bg-beige-200">
    <div class="progress-bar h-4 z-110 fixed w-full bg-[url('/img/progress_bar.svg')] left-0 origin-top-left top-0 right-0"></div>
    <!-- START PÅ HERO -->
    <!-- START HERO PÅ AKTIVITETER -->
    <div class="px-10 lg:px-20 py-4">
      <Breadcrumbs
        textColor="text-stronger"
        homeIcon="/icons/home.svg"
        items={[
          { label: "Forside", href: "/" },
          { label: "Aktiviteter", href: "/alle_aktiviteter" },
        ]}
      />
    </div>
    <section class="flex flex-col justify-center items-center gap-10">
      <Heading htmlheading="h1" size="large" font="heading" stylingclasses="py-4 text-stronger text-center intersect:animate-fade-down animate-once animate-duration-[2000ms]">Alle aktiviteter</Heading>
      <form class="w-80 lg:w-120">
        <label for="search" class="text-sm font-medium text-heading sr-only">Search</label>
        <div class="relative">
          <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
            <svg class="w-4 h-4 text-body" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="m21 21-3.5-3.5M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"></path></svg>
          </div>
          <input type="search" id="search" class="block w-full p-3 ps-9 bg-bg-beige-300 text-heading text-sm rounded-base border-1 border-stroke-dark placeholder:text-body transition-colors focus:outline-none focus:border-2 focus:ring-0 focus:border-stroke-primary-accent" placeholder="Søg" required />
        </div>
      </form>
    </section>
    <!-- SLUT HERO PÅ AKTIVITETER -->

    <!-- START PÅ CARDS OVERSIGT -->
    <section class="grid grid-cols-2 gap-2 px-4 py-20 justify-items-center lg:grid-cols-4 lg:mx-40 lg:gap-5 intersect:animate-fade-up animate-once animate-duration-[2000ms]">
      <Aktivitet_card class="col-span-1 lg:col-span-2 order-1" title="Sumobrydning" personer="+2 personer" tid="1 time" img="/sumobrydning.webp" pris="FRA 2500 kr" badge="LEG" href="/singleview" />

      <Aktivitet_card class="col-span-1 lg:col-span-2 order-2" title="Paintball" personer="+4 personer" tid="1-2 timer" img="/img/paintball.webp" pris="FRA 300 kr" badge="action" href="/singleview" />

      <Aktivitet_card class="col-span-1 lg:col-span-2 order-3" title="Bowtag" personer="+10 personer" tid="1 time" img="/img/bow_tag.webp" pris="FRA 2500 kr" badge="præcision" href="/singleview" />

      <Aktivitet_card class="col-span-1 lg:col-span-2 order-4 lg:order-5" title="Bueskydning" personer="+10 personer" tid="30 time" img="/img/bueskydning.webp" pris="FRA 2500 kr" badge="præcision" href="/singleview" />

      <img src="/img/img1_oversigt.webp" alt="Hardball" class="col-span-2 lg:col-span-2 lg:row-span-2 order-5 lg:order-4 rounded-lg h-100 lg:h-full lg:w-full object-cover" />

      <Aktivitet_card class="col-span-1 lg:col-span-2 order-6" title="Dødningbold" personer="+8 personer" tid="1 time" img="/img/dødningebold.webp" pris="FRA 2500 kr" badge="LEG" href="/singleview" />

      <Aktivitet_card class="col-span-1 lg:col-span-2 order-7" title="Forhindringsbane" personer="+3 personer" tid="1 time" img="/img/forhindringsbane.webp" pris="FRA 2500 kr" badge="samarbejde" href="/singleview" />

      <Aktivitet_card class="col-span-1 lg:col-span-2 order-8" title="Hardball" personer="+4 personer" tid="2 timer" img="/img/hardball.webp" pris="FRA 400 kr" badge="action" href="/singleview" />

      <Aktivitet_card class="col-span-1 lg:col-span-2 order-9" title="Kæmpe Bordfodbold" personer="+8 personer" tid="1 time" img="/img/kæmpe_bordfodbold.webp" pris="FRA 2500 kr" badge="samarbejde" href="/singleview" />

      <img src="/img/aktivitetside2.webp" alt="" class="col-span-2 order-10 rounded-lg h-100 w-full object-cover lg:col-span-2 lg:h-full lg:row-span-2" />

      <Aktivitet_card class="col-span-1 lg:col-span-2 order-11" title="Lasertag" personer="+10 personer" tid="1 time" img="/img/lasertag.webp" pris="FRA 2500 kr" badge="action" href="/singleview" />

      <Aktivitet_card class="col-span-1 lg:col-span-2 order-12" title="Megaboksning" personer="+2 personer" tid="1 time" img="/img/megaboksning.webp" pris="FRA 2500 kr" badge="LEG" href="/singleview" />

      <Aktivitet_card class="col-span-1 lg:col-span-2 order-13" title="Stokkekamp" personer="+2 personer" tid="1 time" img="/img/stokkekamp.webp" pris="FRA 2500 kr" badge="LEG" href="/singleview" />

      <Aktivitet_card class="col-span-1 lg:col-span-2 order-14" title="Spydkast" personer="+2 personer" tid="1 time" img="/img/spydkast.webp" pris="FRA 2500 kr" badge="action" href="/singleview" />
    </section>
    <!-- SLUT PÅ CARDS OVERSIGT -->

    <section>
      <Book_section heading="Vil i spise i parken?" linktext="Se vores menu" bg="bg-bg-beige-400" linkvariant="tertiary" />
    </section>
  </main>
</MainLayout>
<script>
  import { animate, stagger, inView, scroll } from "motion";

  /*Progress-baren/læseindikatoren */
  scroll(animate(".progress-bar", { scaleX: [0, 1] }));
</script>
