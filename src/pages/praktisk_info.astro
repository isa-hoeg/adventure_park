---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Fold_ud_card from "../components/Fold_ud_card.astro";
---

<MainLayout title="Titel">
  <!-- HERO-->
  <div class="relative w-full bg-cover bg-center lg:bg-bottom h-[300px] lg:h-[500px] bg-[url('/img/praktisk_info_hero.webp')]">
    <div class="absolute inset-0 bg-bg-army-700 opacity-60"></div>

    <!-- OBJEKT BILLEDE - kun på desktop -->
    <img src="/img/object-praktisk.webp" alt="udstyr" class="absolute scale-50 left-34 top-28 lg:scale-105 lg:right-15 lg:left-210 lg:top-30" />

    <!-- TEKST -->
    <div class="relative h-full flex items-center px-[42px]">
      <div>
        <Heading htmlheading="h1" size="large" font="display" stylingclasses="text-weakest text-center lg:text-left">Praktisk info</Heading>
        <div class="border-4 w-30 lg:w-80 border-bg-coral-400 mx-auto lg:mx-0"></div>
      </div>
    </div>
  </div>

  <!--SPISNING-->
  <div class="bg-bg-beige-400 py-[112px] px-[40px]">
    <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-stronger mb-8">Nyheder</Heading>
    <div class="flex flex-col lg:flex-row gap-4">
      <Fold_ud_card billede="/img/nyheder_1.webp" titel="Mystery Run" tekst="Forestil dig spænding fra Escape Rooms – men udendørs." href="/nyheder" open={true} />
      <Fold_ud_card billede="/img/paintball.webp" titel="Nye Lasertag Pistoler!" tekst="Lorem ipsum lorem ipsum" href="/nyheder" />
      <Fold_ud_card billede="/img/nyheder_2.webp" titel="Sommer Camp 2026!" tekst="Lorem ipsum lorem ipsum" href="/nyheder" />
      <Fold_ud_card billede="/img/kategori_1.webp" titel="Baner gjort sommerklar!" tekst="Lorem ipsum lorem ipsum" href="/nyheder" />
    </div>
  </div>
</MainLayout>
