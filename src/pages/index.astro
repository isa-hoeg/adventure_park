---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import { Image } from "astro:assets";
import thumbsup from "../assets/images/thumbsup.png";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import Anmeldelse_card from "../components/Anmeldelse_card.astro";
import Kategori_card from "../components/Kategori_card.astro";
import Selling_card from "../components/Selling_card.astro";
import Map from "../components/Map.astro";
import Fold_ud_card from "../components/Fold_ud_card.astro";
import Insta_card from "../components/Insta_card.astro";
---

<MainLayout title="Titel">
  <!-- START PÅ HERO -->
  <div class="w-full bg-cover bg-center pb-50 lg:pb-0 bg-[url('/img/hero_mobile.webp')] grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
    <div class="bg-bg-army-opacity p-15 lg:ml-20 w-full">
      <Heading htmlheading="h1" size="display" font="display" stylingclasses="text-neongreen-400 text-center">Klar til <br class="hidden lg:block" /> kamp?</Heading>
      <Text teksttype="brødtekst-body" stylingclasses="text-weakest text-center mt-4 lg:mt-10 mb-8 font-semibold">Vi har Sjællands største baner. Saml vennerne, kollegaerne eller familien og book en oplevelse fyldt med fart, grin og konkurrence.</Text>
      <div class="flex flex-row">
        <Link href="/booking" variant="primary" size="large" stylingclasses="">Book nu</Link>
        <Link href="/alle_aktiviteter" variant="secondary" size="large" stylingclasses="">Se alle aktiviteter</Link>
      </div>
    </div>
  </div>

  <!-- SLUT PÅ MAP SEKTION -->
  <!-- KATEGORICARDS -->
  <div class="bg-bg-beige-200 py-10 lg:py-20">
    <div class="container mx-auto px-[42px]">
      <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-stronger text-center mb-10">
        Find jeres næste <span class="border-b-5 border-bg-coral-400">oplevelse</span>
      </Heading>
      <div class="flex flex-col lg:flex-row gap-4">
        <Kategori_card billede="/img/kategori_1.webp" titel="Firmaer" tag1="Samarbejde" tag2="Fællesskab" href="/aktiviteter" />
        <Kategori_card billede="/img/kategori_2.webp" titel="Børn & Unge" tag1="Leg" tag2="Sjov" href="/aktiviteter" />
        <Kategori_card billede="/img/kategori_3.webp" titel="Private" tag1="Fødselsdag" tag2="Polterabend" href="/aktiviteter" />
      </div>
    </div>
    <!-- KNAP: "SE ALLE AKTIVITETER" -->
    <div class="flex justify-center mt-8">
      <Link href="/alle_aktiviteter" variant="secondary" size="large">SE ALLE AKTIVITETER</Link>
    </div>
  </div>
  <!-- SLUT PÅ KATEGORICARDS -->

  <!-- START PÅ SELLING POINTS -->
  <div class="relative w-full bg-cover bg-center py-20 lg:py-20" style="background-image: url('/img/selling_points_bg.webp');">
    <div class="flex items-center justify-center">
      <div class="bg-bg-army-opacity mx-8 px-8 py-10 lg:py-15 flex flex-col gap-6 rounded-xl max-w-5xl">
        <div class="flex flex-row gap-4 lg:mx-auto">
          <div class="w-2 h-18 lg:h-18 bg-stroke-secondary-accent"></div>
          <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-weakest">
            <span class="block lg:inline">Derfor vælger</span>
            <span class="block lg:inline">gæsterne os</span>
          </Heading>
        </div>
        <Text teksttype="brødtekst-body" stylingclasses="text-weakest lg:max-w-xl lg:mx-auto"> Hos os får I mere end bare en aktivitet. I får en gennemført oplevelse fra start til slut. Med Sjællands største baner, skarpe priser og fokus på sikkerhed skaber vi rammerne for action, grin og stærke fællesskaber. Vi sørger for, at jeres dag bliver både nem at planlægge og svær at glemme. </Text>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 lg:gap-x-8 gap-y-15 pt-10">
          <Selling_card icon="/icons/fleksibilitet.svg" iconalt="ikon for fleksibilitet" title="Fleksibilitet" cardtekst="Åbent efter aftale: Vi kan afvikle events inde og ude hele døgnet." />
          <Selling_card icon="/icons/sikkerhed.svg" iconalt="ikon for sikkerhed" title="Sikkerhed" cardtekst="Alle vores aktiviteter er godkendt og alle kunder er forsikret gennem os." />
          <Selling_card icon="/icons/erfaring.svg" iconalt="ikon for erfaring" title="Erfaring" cardtekst="Vi har udviklet og afholdt fornøjelses- og teambuildings-arrangementer i ca. 20 år." />
          <Selling_card icon="/icons/kapacitet.svg" iconalt="ikon for kapacitet" title="Kapacitet" cardtekst="Vi har en udendørs park med 80.000 m2 til afvikling af arrangementer og afholder events for grupper i alle størrelser." />
        </div>
      </div>
    </div>
  </div>
  <!-- SLUT PÅ SELLING POINTS -->

  <!-- NYHEDSSEKTION-->
  <div class="bg-bg-beige-400 py-[112px] px-[40px]">
    <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-stronger mb-8">Nyheder</Heading>
    <div class="flex flex-col lg:flex-row gap-4">
      <Fold_ud_card billede="/img/nyheder_1.webp" titel="Mystery Run" tekst="Forestil dig spænding fra Escape Rooms – men udendørs." href="/nyheder" open={true} />
      <Fold_ud_card billede="/img/paintball.webp" titel="Nye Lasertag Pistoler!" tekst="Lorem ipsum lorem ipsum" href="/nyheder" />
      <Fold_ud_card billede="/img/nyheder_2.webp" titel="Sommer Camp 2026!" tekst="Lorem ipsum lorem ipsum" href="/nyheder" />
      <Fold_ud_card billede="/img/kategori_1.webp" titel="Baner gjort sommerklar!" tekst="Lorem ipsum lorem ipsum" href="/nyheder" />
    </div>
  </div>
  <!-- SLUT PÅ NYHEDSSEKTION -->

  <!-- START PÅ ANMELDELSESSEKTION -->
  <div class="bg-bg-coral-400 flex flex-col lg:flex-row py-10 lg:py-20">
    <div class="flex flex-col px-20 py-5 lg:py-25">
      <img src="/icons/situationstegn.svg" alt="situationstegn" class="w-12 h-12 lg:w-20 lg:h-20" />
      <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-strongest text-center">Det siger gæsterne</Heading>
    </div>

    <div class="overflow-hidden w-full">
      <div class="flex gap-10 p-8 animate-scroll w-max">
        <!-- <div class="flex flex-row overflow-x-auto gap-10 p-8 animate-scroll">  -->
        <Anmeldelse_card userimage="user1.svg" userimagealt="user bruger 1" username="Maria, 28 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/filled_star.svg" rating5="/icons/filled_star.svg" ratingsalt="rating stjerne" cardtekst1="Vi havde en fantastisk oplevelse hos Adventure Park! Min veninde skal giftes og elsker action, hvorfor vi valgte at holde hendes polterabend hos dem. Vi bookede 2 timers paintball, hvorefter vi tilkøbte parkens grill-menu, så vi ikke skulle finde et andet sted at spise. Super god service og gode faciliteter!" cardtekst2="Jeg vil i den grad anbefale parken til andre, der skal bruge en sjov gruppeaktivitet!" />
        <Anmeldelse_card userimage="user2.svg" userimagealt="user bruger 2" username="Jakob, 33 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/filled_star.svg" rating5="/icons/star.svg" ratingsalt="rating stjerne" cardtekst1="Jeg bookede 1 times lasertag og 1 times paintball i forbindelse med min fødselsdag. Vi var en gruppe bestående af 11 gutter, og det fungerede super godt!" cardtekst2="Vi blev taget godt imod i parken, hvor vi fik en tydelig instruktion i de to aktiviteter. Det var nogle super fine faciliteter i dejlig natur og fede baner! Jeg havde selv sørget for mad, men vi benyttede os af at købe drikkevarer efterfølgende, så vi alle kunne slutte af med en kold fadøl." />
        <Anmeldelse_card userimage="user3.svg" userimagealt="user bruger 3" username="Katja, 29 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/filled_star.svg" rating5="/icons/filled_star.svg" ratingsalt="rating stjerne" cardtekst1="Super skøn naturpark med fede aktiviteter!" cardtekst2="Vi havde lidt udfordringer med at finde derhen, men blev heldigvis mødt af et stort smil på trods af 10 minutters forsinkelse. Jeg kan klart anbefale parken!" />
        <Anmeldelse_card userimage="user4.svg" userimagealt="user bruger 4" username="Henrik, 44 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/filled_star.svg" rating5="/icons/filled_star.svg" ratingsalt="rating stjerne" cardtekst1="Min kone og jeg elsker action, hvorfor vi besluttede at holde en fælles fødselsdsag i Adventure Park." cardtekst2="Skide sjove aktiviteter og fedt område. Det var også genialt for os, at man kunne tilkøbe mad, hvorfor vi ikke skulle stå for en masse, men blot kunne invitere vennerne på en sjov oplevelse." />
        <Anmeldelse_card userimage="user5.svg" userimagealt="user bruger 5" username="Simon, 28 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/filled_star.svg" rating5="/icons/filled_star.svg" ratingsalt="rating stjerne" cardtekst1="Jeg skulle stå for aktiviteter for min venindes polterabend og var på ret bar bund. Blev så anbefalet Adventure Park, og det var perfekt til os. Vi bookede to forskellige aktiviteter og havde det så sjovt fra start til slut. Efterfølgende spiste vi alle mad i parken og nød godt af en masse drikkevarer. Stor anbefaling herfra!" cardtekst2="" />
        <Anmeldelse_card userimage="user6.svg" userimagealt="user bruger 6" username="Laila, 38 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/filled_star.svg" rating5="/icons/star.svg" ratingsalt="rating stjerne" cardtekst1="Jeg bookede lasertag til vores temadag på jobbet, da jeg tænkte, vores team havde godt af en lidt action-præget aktivitet." cardtekst2="Det var en sjov måde at skulle samarbejde på, og vi virkelig brændt noget krudt af. Jeg havde ikke selv prøvet det før og var lidt nervøs i forhold til, hvor jeg skulle booke, men jeg havde en rigtig god oplevelse med Adventure Park. Dejligt naturskønt sted!" />
        <Anmeldelse_card userimage="user7.svg" userimagealt="user bruger 7" username="Lukas, 24 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/star.svg" rating5="/icons/star.svg" ratingsalt="rating stjerne" cardtekst1="Mine venner og jeg havde en fed paintball dyst. Vi blev taget godt imod og blev grundigt introduceret, inden vi kom ind på banen." cardtekst2="Tiden fløj afsted, så en anden gang booker vi nok en ekstra time!" />
      </div>
    </div>
  </div>
  <!-- SLUT PÅ ANMELDELSESSEKTION -->

  <!-- START PÅ MAP SEKTION -->
  <div class="w-full bg-cover bg-center py-20
         bg-[url('/img/map_mobile.webp')]
         lg:bg-[url('/img/map.webp')]">
    <Map />
  </div>

  <!-- SLUT PÅ MAP SEKTION -->

  <!--  SOME SEKTION -->
  <div class="bg-bg-beige-400 py-10 lg:py-20">
    <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-stronger text-center mb-8">Følg med på sociale medier</Heading>

    <div x-data="{ current: 0 }" class="relative flex items-center gap-4 px-[40px]">
      <!-- PIL VENSTRE -->
      <!-- <button x-on:click="current = current > 0 ? current - 1 : 0" class="flex-shrink-0"> -->
      <img src="/icons/icon_some_left.svg" alt="forrige" class="w-10 h-10" />
      <!-- </button> -->

      <!-- KORT CONTAINER -->
      <div class="overflow-hidden flex-1">
        <div class="flex gap-4 transition-transform duration-300" :style="`transform: translateX(calc(-${current} * (280px + 1rem)))`">
          <Insta_card img="/img/instapost1.webp" likes="120" comments="14" caption="Fed dag i parken!" />
          <Insta_card img="/img/instapost2.webp" likes="98" comments="8" caption="Paintball er det bedste!" />
          <Insta_card img="/img/instapost3.webp" likes="200" comments="22" caption="Sommer camp 2026!" />
          <Insta_card img="/img/instapost4.webp" likes="150" comments="10" caption="Mystery Run!" />
          <Insta_card img="/img/instapost5.webp" likes="120" comments="14" caption="Paintball i Adventure Park!" />
        </div>
      </div>

      <!-- PIL HØJRE -->
      <!-- <button x-on:click="current = current < 3 ? current + 1 : 3" class="flex-shrink-0"> -->
      <img src="/icons/icon_some_right.svg" alt="næste" class="w-10 h-10" />
      <!-- </button> -->
    </div>
  </div>
</MainLayout>
