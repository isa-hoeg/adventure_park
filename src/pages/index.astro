---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import { Image } from "astro:assets";
import thumbsup from "../assets/images/thumbsup.png";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import Anmeldelse_card from "../components/Anmeldelse_card.astro";
import Kategori_card from "../components/Kategori_card.astro";
import Selling_card from "../components/Selling_card.astro";
import Map from "../components/Map.astro";
import Fold_ud_card from "../components/Fold_ud_card.astro";
import Insta_card from "../components/Insta_card.astro";
---

<MainLayout title="Forside" description="Adventure Park tilbyder actionfyldte oplevelser med paintball, lasertag og teambuilding på Sjælland.">
   <div class="progress-bar h-4 z-110 fixed w-full bg-[url('/img/progress_bar.svg')] left-0 origin-top-left top-0 right-0"></div>
  <!-- START PÅ HERO -->
  <section class="bg-[url('/img/hero_bg_mobil.webp')] bg-bg-army-700 relative min-h-[720px] h-[90vh] max-h-[860px] w-full bg-cover bg-center bg-no-repeat overflow-hidden lg:bg-[url('/img/hero_bg.webp')] lg:h-158 ">
    <div id="hero" class="bg-bg-army-opacity flex flex-col items-center justify-center text-center px-8 pb-12 pt-10 gap-4 lg:text-left lg:w-170 lg:items-start lg:ml-25 lg:py-8 lg:h-full">
      <Heading htmlheading="h1" size="display" font="display" stylingclasses="text-neongreen-400 animate-fade-down animate-once animate-duration-500 animate-ease-linear">Klar til kamp?</Heading>
      <Text teksttype="brødtekst-body" stylingclasses="text-weakest font-semibold lg:w-120 animate-fade-right animate-once animate-duration-500 animate-delay-600 animate-ease-linear">Vi har Sjællands største baner. Saml vennerne, kollegaerne eller familien og book en oplevelse fyldt med fart, grin og konkurrence.</Text>
      <div class="flex flex-row gap-4 animate-fade-right animate-once animate-duration-500 animate-delay-1200 animate-ease-linear">
        <Text><Link href="/booking" variant="primary" size="large">book nu</Link></Text>
        <Text><Link href="/alle_aktiviteter" variant="secondary" size="large">se alle aktiviteter</Link></Text>
      </div>
    </div>
    <img src="/img/hero_bg_mobil_overlay.webp" alt="overlay af familie_mobil" class="absolute left-1/2 bottom-0 w-full max-w-[520px] -translate-x-1/2 lg:hidden">
    <img src="/img/hero_bg_overlay.webp" alt="overlay af familie" width="1920" height="1080" class="hidden lg:block lg:absolute lg:origin-top lg:top-20 lg:left-67 lg:scale-57 ">
  </section>

  <!-- SLUT PÅ HERO -->
  <!-- KATEGORICARDS -->
  <div class="bg-bg-beige-200 py-10 lg:py-20">
    <div class="container mx-auto px-[42px]">
      <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-stronger text-center mb-10 intersect:animate-fade-right animate-once animate-duration-[2000ms]">
        Find jeres næste <span class="border-b-5 border-bg-coral-400">oplevelse</span>
      </Heading>
      <div class="flex flex-col lg:flex-row gap-4">
        <Kategori_card billede="/img/kategori_1.webp" titel="Firmaer" tag1="Samarbejde" tag2="Fællesskab" href="/alle_aktiviteter" />
        <Kategori_card billede="/img/kategori_2.webp" titel="Børn & Unge" tag1="Leg" tag2="Sjov" href="/alle_aktiviteter" />
        <Kategori_card billede="/img/kategori_3.webp" titel="Private" tag1="Fødselsdag" tag2="Polterabend" href="/alle_aktiviteter" />
      </div>
    </div>
    <!-- KNAP: "SE ALLE AKTIVITETER" -->
    <div class="flex justify-center mt-8 intersect:animate-fade-up animate-once animate-duration-[2000ms]">
      <Link href="/alle_aktiviteter" variant="secondary" size="large">SE ALLE AKTIVITETER</Link>
    </div>
  </div>
  <!-- SLUT PÅ KATEGORICARDS -->

  <!-- START PÅ SELLING POINTS -->
  <div class="relative w-full bg-cover bg-center py-20 lg:py-20" style="background-image: url('/img/selling_points_bg.webp');">
    <div class="flex items-center justify-center">
      <div class="bg-bg-army-opacity mx-8 px-8 py-10 lg:py-15 flex flex-col gap-6 rounded-xl lg:w-320">
        <!-- OVERSKRIFT med coral streg -->
        <div class="flex flex-row gap-4 lg:mx-auto">
          <div class="w-2 h-18 lg:h-18 bg-stroke-secondary-accent"></div>
          <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-weakest intersect:animate-fade-left animate-once animate-duration-[2000ms]">
            <span class="block lg:inline">Derfor vælger</span>
            <span class="block lg:inline">gæsterne os</span>
          </Heading>
        </div>

        <!-- BRØDTEKST -->
        <Text teksttype="brødtekst-body" stylingclasses="text-weakest lg:-mt-6 lg:max-w-xl lg:mx-auto"> Hos os får I mere end bare en aktivitet. I får en gennemført oplevelse fra start til slut. Med Sjællands største baner, skarpe priser og fokus på sikkerhed skaber vi rammerne for action, grin og stærke fællesskaber. Vi sørger for, at jeres dag bliver både nem at planlægge og svær at glemme. </Text>

        <!-- 4 SELLING CARDS - grid med 2 kolonner på mobil, 4 på desktop -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 lg:gap-x-8 gap-y-15 pt-10">
          <div class="intersect:animate-fade-up animate-once animate-duration-[2000ms]">
            <Selling_card icon="/icons/fleksibilitet.svg" iconalt="ikon for fleksibilitet" title="Åbningstider" cardtekst="Åbent efter aftale: Vi kan afvikle events inde og ude hele døgnet." />
          </div>

          <div class="intersect:animate-fade-down animate-once animate-duration-[2000ms]">
            <Selling_card icon="/icons/sikkerhed.svg" iconalt="ikon for sikkerhed" title="Sikkerhed" cardtekst="Alle vores aktiviteter er godkendt og alle kunder er forsikret gennem os." />
          </div>

          <div class="intersect:animate-fade-up animate-once animate-duration-[2000ms]">
            <Selling_card icon="/icons/erfaring.svg" iconalt="ikon for erfaring" title="Erfaring" cardtekst="Vi har udviklet og afholdt fornøjelses- og teambuildings-arrangementer i ca. 20 år." />
          </div>

          <div class="intersect:animate-fade-down animate-once animate-duration-[2000ms]">
            <Selling_card icon="/icons/kapacitet.svg" iconalt="ikon for kapacitet" title="Kapacitet" cardtekst="Vi har en udendørs park med 80.000 m2 til afvikling af arrangementer og afholder events for grupper i alle størrelser." />
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- SLUT PÅ SELLING POINTS -->

  <!-- ============================================== -->
  <!-- NYHEDSSEKTION - kort med seneste nyheder       -->
  <!-- ============================================== -->
  <!-- 
  bg-bg-beige-400          = beige baggrund
  py-[112px]               = padding top/bund 112px (custom værdi)
  px-[40px]                = padding sider 40px (custom værdi)
-->
  <div class="bg-bg-beige-400 py-[112px] px-0 pl-8 lg:px-[40px]">
    <!-- OVERSKRIFT med animation -->
    <!-- 
    text-stronger                                     = mørk tekstfarve
    mb-8                                              = margin-bottom 32px
    intersect:animate-fade-right                      = animerer ind fra højre når sektionen kommer i syne
    animate-once                                      = animationen kører kun én gang
    animate-duration-[2000ms]                         = animationen tager 2 sekunder
  -->
    <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-stronger mb-8 intersect:animate-fade-right animate-once animate-duration-[2000ms]">Nyheder</Heading>

    <!-- WRAPPER FOR KORTENE - horisontal scroll både mobil og desktop -->
    <!-- 
    flex flex-row                  = kortene ligger ved siden af hinanden
    gap-4                          = 16px afstand mellem kortene
    overflow-x-auto                = horisontal scroll når der ikke er plads
    intersect:animate-fade-left    = animerer ind fra venstre når sektionen kommer i syne
    animate-once                   = animationen kører kun én gang
    animate-duration-[2000ms]      = animationen tager 2 sekunder
  -->
    <div class=" flex flex-row gap-4 overflow-x-auto intersect:animate-fade-left animate-once animate-duration-[2000ms]">
      <!-- FOLD UD KORT 1 - "Mystery Run" - starter åbent som standard -->
      <!-- 
      stregHøjde="h-20"            = den lodrette streg er 80px høj
      højde="h-[350px]"            = kortet er 350px højt
      mobilBredde="w-[340px]"      = 340px bredt på mobil
      bredde="lg:w-[340px]"        = 340px bredt på desktop (når lukket)
      open={true}                  = dette kort starter åbent
      Bemærk: når et kort åbnes, bliver det 500px bredt (styret i Fold_ud_card komponentet)
      accentColor er ikke sat - bruger default coral (#fe4559)
    -->
      <Fold_ud_card stregHøjde="h-20" højde="h-[350px]" mobilBredde="w-[340px]" bredde="lg:w-[340px]" billede="/img/nyheder_1.webp" titel="Mystery Run" href="/nyheder" open={true}>
        <Text stylingclasses="text-stronger">Forestil dig spænding fra Escape Rooms – men udendørs. I bevæger jer fra sted til sted, mens I løser gåder, knækker koder samt optjener og stjæler point undervejs.</Text>
      </Fold_ud_card>

      <!-- FOLD UD KORT 2 - "Nye Lasertag Pistoler" - lg:w-[300px] = lidt smallere på desktop -->
      <Fold_ud_card stregHøjde="h-20" højde="h-[350px]" mobilBredde="w-[340px]" bredde="lg:w-[300px]" billede="/img/paintball.webp" titel="Nye Lasertag Pistoler!" href="/nyheder">
        <Text stylingclasses="text-stronger">Oplev næste niveau af lasertag med vores nye pistoler. Hurtigere reaktion, bedre præcision og endnu mere intens gameplay – perfekt til både venner og firmaevents.</Text>
      </Fold_ud_card>

      <!-- FOLD UD KORT 3 - "Sommer Camp 2026" -->
      <Fold_ud_card stregHøjde="h-20" højde="h-[350px]" mobilBredde="w-[340px]" bredde="lg:w-[300px]" billede="/img/nyheder_2.webp" titel="Sommer Camp 2026!" href="/nyheder">
        <Text stylingclasses="text-stronger">En uge fyldt med action, fællesskab og uforglemmelige oplevelser. Vores sommer camp kombinerer sjove aktiviteter med nye venskaber i trygge rammer.</Text>
      </Fold_ud_card>

      <!-- FOLD UD KORT 4 - "Baner gjort sommerklar" -->
      <Fold_ud_card stregHøjde="h-20" højde="h-[350px]" mobilBredde="w-[340px]" bredde="lg:w-[300px]" billede="/img/kategori_1.webp" titel="Baner gjort sommerklar!" href="/nyheder">
        <Text stylingclasses="text-stronger">Vores baner er klargjort til sommerens mange events. Glæd jer til forbedrede faciliteter, nye udfordringer og endnu bedre rammer for jeres oplevelse.</Text>
      </Fold_ud_card>
    </div>
  </div>
  <!-- SLUT PÅ NYHEDSSEKTION -->

  <!-- START PÅ ANMELDELSESSEKTION -->
  <div class="bg-bg-coral-400 flex flex-col lg:flex-row py-10 lg:py-20">
    <div class="flex flex-col px-20 py-5 lg:py-25">
      <img src="/icons/situationstegn.svg" alt="situationstegn" class="w-12 h-12 lg:w-20 lg:h-20" />
      <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-strongest text-center intersect:animate-fade-down animate-once animate-duration-[2000ms]">Det siger gæsterne</Heading>
    </div>

    <div class="overflow-hidden w-full">
      <div class="flex gap-10 p-8 animate-scroll w-max">
        <!-- <div class="flex flex-row overflow-x-auto gap-10 p-8 animate-scroll">  -->
        <Anmeldelse_card userimage="user1.svg" userimagealt="user bruger 1" username="Maria, 28 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/filled_star.svg" rating5="/icons/filled_star.svg" ratingsalt="" cardtekst1="Vi havde en fantastisk oplevelse hos Adventure Park! Min veninde skal giftes og elsker action, hvorfor vi valgte at holde hendes polterabend hos dem. Vi bookede 2 timers paintball, hvorefter vi tilkøbte parkens grill-menu, så vi ikke skulle finde et andet sted at spise. Super god service og gode faciliteter!" cardtekst2="Jeg vil i den grad anbefale parken til andre, der skal bruge en sjov gruppeaktivitet!" />
        <Anmeldelse_card userimage="user2.svg" userimagealt="user bruger 2" username="Jakob, 33 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/filled_star.svg" rating5="/icons/star.svg" ratingsalt="" cardtekst1="Jeg bookede 1 times lasertag og 1 times paintball i forbindelse med min fødselsdag. Vi var en gruppe bestående af 11 gutter, og det fungerede super godt!" cardtekst2="Vi blev taget godt imod i parken, hvor vi fik en tydelig instruktion i de to aktiviteter. Det var nogle super fine faciliteter i dejlig natur og fede baner! Jeg havde selv sørget for mad, men vi benyttede os af at købe drikkevarer efterfølgende, så vi alle kunne slutte af med en kold fadøl." />
        <Anmeldelse_card userimage="user3.svg" userimagealt="user bruger 3" username="Katja, 29 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/filled_star.svg" rating5="/icons/filled_star.svg" ratingsalt="" cardtekst1="Super skøn naturpark med fede aktiviteter!" cardtekst2="Vi havde lidt udfordringer med at finde derhen, men blev heldigvis mødt af et stort smil på trods af 10 minutters forsinkelse. Jeg kan klart anbefale parken!" />
        <Anmeldelse_card userimage="user4.svg" userimagealt="user bruger 4" username="Henrik, 44 år" rating1="/icons/filled_star.svg"rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/filled_star.svg" rating5="/icons/filled_star.svg" ratingsalt="" cardtekst1="Min kone og jeg elsker action, hvorfor vi besluttede at holde en fælles fødselsdsag i Adventure Park." cardtekst2="Skide sjove aktiviteter og fedt område. Det var også genialt for os, at man kunne tilkøbe mad, hvorfor vi ikke skulle stå for en masse, men blot kunne invitere vennerne på en sjov oplevelse." />
        <Anmeldelse_card userimage="user5.svg" userimagealt="user bruger 5" username="Simon, 28 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/filled_star.svg" rating5="/icons/filled_star.svg" ratingsalt="" cardtekst1="Jeg skulle stå for aktiviteter for min venindes polterabend og var på ret bar bund. Blev så anbefalet Adventure Park, og det var perfekt til os. Vi bookede to forskellige aktiviteter og havde det så sjovt fra start til slut. Efterfølgende spiste vi alle mad i parken og nød godt af en masse drikkevarer. Stor anbefaling herfra!" cardtekst2="" />
        <Anmeldelse_card userimage="user6.svg" userimagealt="user bruger 6" username="Laila, 38 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/filled_star.svg" rating5="/icons/star.svg" ratingsalt="" cardtekst1="Jeg bookede lasertag til vores temadag på jobbet, da jeg tænkte, vores team havde godt af en lidt action-præget aktivitet." cardtekst2="Det var en sjov måde at skulle samarbejde på, og vi virkelig brændt noget krudt af. Jeg havde ikke selv prøvet det før og var lidt nervøs i forhold til, hvor jeg skulle booke, men jeg havde en rigtig god oplevelse med Adventure Park. Dejligt naturskønt sted!" />
        <Anmeldelse_card userimage="user7.svg" userimagealt="user bruger 7" username="Lukas, 24 år" rating1="/icons/filled_star.svg" rating2="/icons/filled_star.svg" rating3="/icons/filled_star.svg" rating4="/icons/star.svg" rating5="/icons/star.svg" ratingsalt="" cardtekst1="Mine venner og jeg havde en fed paintball dyst. Vi blev taget godt imod og blev grundigt introduceret, inden vi kom ind på banen." cardtekst2="Tiden fløj afsted, så en anden gang booker vi nok en ekstra time!" />
      </div>
    </div>
  </div>
  <!-- SLUT PÅ ANMELDELSESSEKTION -->

  <!-- START PÅ MAP SEKTION -->
  <Map/>
  <!-- SLUT PÅ MAP SEKTION -->

 
        

  <!--  SOME SEKTION -->
 <section class="bg-bg-beige-400 py-10 lg:py-20">
  <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="text-stronger text-center mb-8 intersect:animate-fade-up animate-once animate-duration-[2000ms]">Følg med på sociale medier</Heading>

  <!-- CAROUSEL WRAPPER -->
  <div class="lg:flex lg:overflow-x-auto lg:snap-x lg:snap-mandatory ">

    <!-- SLIDE 1 -->
    <div id="carousel1" class="scroll-mt-54 min-w-full snap-start lg:flex lg:justify-center lg:items-center">

      <div class="grid grid-cols-2 gap-2 p-8 lg:flex lg:flex-row intersect:animate-fade-right animate-once animate-duration-[2000ms]">
        <Insta_card likes="254" comments="5" caption="Kom ud i naturen og mærk suset 🌿 Hos Adventure Park danner omgivelserne rammen for oplevelser, du ikke glemmer." img="/img/instapost1.webp"/>
        <Insta_card likes="254" comments="5" caption="Kom ud i naturen og mærk suset 🌿 Hos Adventure Park danner omgivelserne rammen for oplevelser, du ikke glemmer." img="/img/instapost2.webp" />
        <Insta_card likes="254" comments="5" caption="Kom ud i naturen og mærk suset 🌿 Hos Adventure Park danner omgivelserne rammen for oplevelser, du ikke glemmer." img="/img/instapost3.webp" />
        <Insta_card likes="254" comments="5" caption="Kom ud i naturen og mærk suset 🌿 Hos Adventure Park danner omgivelserne rammen for oplevelser, du ikke glemmer." img="/img/instapost4.webp" />
      </div>

      <!-- Højre pil -->
      <a href="#carousel2" class="group hidden lg:block">
        <img src="/icons/icon_some_right.svg" alt="næste" class="w-12 group-hover:hidden" />
        <img src="/icons/icon_some_right_hover.svg" alt="næste hover" class="hidden w-12 group-hover:block" />
      </a>
    </div>

    <!-- SLIDE 2 -->
    <div id="carousel2" class="hidden scroll-mt-54 min-w-full snap-start lg:flex lg:justify-center lg:items-center">
      
      <!-- Venstre pil -->
      <a href="#carousel1" class="group hidden lg:block">
        <img src="/icons/icon_some_left.svg" alt="forrige" class="w-12 group-hover:hidden" />
        <img src="/icons/icon_some_left_hover.svg" alt="forrige hover" class="hidden w-12 group-hover:block" />
      </a>

      <div class="grid grid-cols-2 gap-2 p-8 lg:flex lg:flex-row">
        <Insta_card likes="254" comments="5" caption="Tag holdet med og find jeres næste oplevelse 🌿" img="/img/instapost2.webp" />
        <Insta_card likes="254" comments="5" caption="Fra paintball til teambuilding — der er noget for alle 👀" img="/img/instapost3.webp" />
        <Insta_card likes="254" comments="5" caption="Klar til en dag fyldt med energi og udfordringer? 💥" img="/img/instapost4.webp" />
        <Insta_card likes="254" comments="5" caption="Action, grin og fællesskab — sådan ser en dag i Adventure Park ud 🔥" img="/img/instapost5.webp"/>
      </div>

      <!-- Højre pil -->
      <a href="#carousel3" class="group hidden lg:block">
        <img src="/icons/icon_some_right.svg" alt="næste" class="w-12 group-hover:hidden" />
        <img src="/icons/icon_some_right_hover.svg" alt="næste hover" class="hidden w-12 group-hover:block" />
      </a>
    </div>

    <!-- SLIDE 3 -->
    <div id="carousel3" class="hidden scroll-mt-54 min-w-full snap-start lg:flex lg:justify-center lg:items-center">
      
      <!-- Venstre pil -->
      <a href="#carousel2" class="group hidden lg:block">
        <img src="/icons/icon_some_left.svg" alt="forrige" class="w-12 group-hover:hidden" />
        <img src="/icons/icon_some_left_hover.svg" alt="forrige hover" class="hidden w-12 group-hover:block" />
      </a>

      <div class="grid grid-cols-2 gap-2 p-8 lg:flex lg:flex-row">
        <Insta_card likes="254" comments="5" caption="Fra paintball til teambuilding — der er noget for alle 👀" img="/img/instapost3.webp" />
        <Insta_card likes="254" comments="5" caption="Klar til en dag fyldt med energi og udfordringer? 💥" img="/img/instapost4.webp" />
        <Insta_card likes="254" comments="5" caption="Action, grin og fællesskab — sådan ser en dag i Adventure Park ud 🔥" img="/img/instapost5.webp"/>
        <Insta_card likes="254" comments="5" caption="Tag holdet med og find jeres næste oplevelse 🌿" img="/img/instapost6.webp" />
      </div>

      <!-- Højre pil -->
      <a href="#carousel4" class="group hidden lg:block">
        <img src="/icons/icon_some_right.svg" alt="næste" class="w-12 group-hover:hidden" />
        <img src="/icons/icon_some_right_hover.svg" alt="næste hover" class="hidden w-12 group-hover:block" />
      </a>
    </div>

    <!-- SLIDE 4 -->
    <div id="carousel4" class="hidden scroll-mt-54 min-w-full snap-start lg:flex lg:justify-center lg:items-center">
      
      <!-- Venstre pil -->
      <a href="#carousel3" class="group hidden lg:block">
        <img src="/icons/icon_some_left.svg" alt="forrige" class="w-12 group-hover:hidden" />
        <img src="/icons/icon_some_left_hover.svg" alt="forrige hover" class="hidden w-12 group-hover:block" />
      </a>

      <div class="grid grid-cols-2 gap-2 p-8 lg:flex lg:flex-row">
        <Insta_card likes="254" comments="5" caption="Klar til en dag fyldt med energi og udfordringer? 💥" img="/img/instapost4.webp" />
        <Insta_card likes="254" comments="5" caption="Action, grin og fællesskab — sådan ser en dag i Adventure Park ud 🔥" img="/img/instapost5.webp"/>
        <Insta_card likes="254" comments="5" caption="Tag holdet med og find jeres næste oplevelse 🌿" img="/img/instapost6.webp" />
        <Insta_card likes="254" comments="5" caption="Fra paintball til teambuilding — der er noget for alle 👀" img="/img/instapost7.webp" />
      </div>

      <!-- Højre pil -->
      <a href="#carousel5" class="group hidden lg:block">
        <img src="/icons/icon_some_right.svg" alt="næste" class="w-12 group-hover:hidden" />
        <img src="/icons/icon_some_right_hover.svg" alt="næste hover" class="hidden w-12 group-hover:block" />
      </a>
    </div>

    <!-- SLIDE 5 -->
    <div id="carousel5" class="hidden scroll-mt-54 min-w-full snap-start lg:flex lg:justify-center lg:items-center">
      
      <!-- Venstre pil -->
      <a href="#carousel4" class="group hidden lg:block">
        <img src="/icons/icon_some_left.svg" alt="forrige" class="w-12 group-hover:hidden" />
        <img src="/icons/icon_some_left_hover.svg" alt="forrige hover" class="hidden w-12 group-hover:block" />
      </a>

      <div class="grid grid-cols-2 gap-2 p-8 lg:flex lg:flex-row">
