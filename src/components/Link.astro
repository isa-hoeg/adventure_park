---
// Henter parametrene fra Astro.props
const {
  href = "#",
  target = "_self",
  variant = "textlink",
  size = "default",
  class: extraClass = "",
  stylingclasses = "",
} = Astro.props as {
  href?: string;
  target?: string;
  variant?: "textlink" | "primary" | "secondary" | "tertiary";
  size?: "default" | "small" | "large";
  class?: string;
  stylingclasses?: string;
};

//Definer den styling (Tailwind classes, der gør sig gældende for alle links
const linkStyling = "";

//Definer den styling (Tailwind classes), der gør sig gældende for de forskellige varianter
const variantClasses = {
  textlink: "underline text-blue-500",
  primary: "flex border-1 justify-center px-4 py-2 border-stroke-dark bg-primary-accent font-heading font-semibold text-stronger hover:bg-primary hover:text-neongreen-400",
  secondary: "flex border-1 justify-center px-4 py-2 border-stroke-dark bg-secondary-beige font-heading font-semibold text-stronger hover:bg-secondary",
  tertiary: "flex border-1 justify-center px-4 py-2 border-stroke-dark bg-tertiary font-heading font-semibold text-stronger hover:bg-secondary",
};

//Definer den styling (Tailwind classes), der gør sig gældende for de forskellige størrelser.
const sizeClasses = {
  default: "",
  small: "text-xs lg:text-sm w-fit", //button i card
  //w-fit er nødvendigt for at knappen ikke skal fylde hele bredden i small size, da den ellers arver flex-1 fra cardet
  large: "text-lg lg:text-2xl", //button i mobil og desktop
};
---

<!--Sæt classes for den pågældende knap sammen ved hjælp af Astros class:list -->
<a href={href} target={target} class:list={[linkStyling, variantClasses[variant], sizeClasses[size], extraClass, stylingclasses]}>
  <slot />
</a>
