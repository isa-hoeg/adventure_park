---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Link from "../components/Link.astro";
import Button from "../components/Button.astro";
import Aktivitet_card from "../components/Aktivitet_card.astro";
import Insta_card from "../components/Insta_card.astro";
import { Image } from "astro:assets";
import AktivitetCard from "../components/Aktivitet_card.astro";

---
<MainLayout title="Titel">
	<main class="container p-4">
		<Heading htmlheading="h1" size="large">Komponentbibliotek</Heading>
        <Text stylingclasses="italic">Her kan du finde alle de komponenter, der er brugt i dette projekt.</Text>
        <hr class="my-4" />
         <!-- start på typografi -->
        <section class="">
            <Heading htmlheading="h2" size="medium" stylingclasses="py-4">Typografi & ovesrkrifter</Heading>
            <Text>Her kan du finde alle de komponenter, der er brugt i dette projekt.</Text>
            <Heading htmlheading="h1" size="display" font="display" stylingclasses="py-4">DISPLAY, BOLDONSE</Heading>
            <Heading htmlheading="h1" size="large" font="display" stylingclasses="py-4">H1, BOLDONSE</Heading>
            <Heading htmlheading="h2" size="medium" font="heading" stylingclasses="py-4">H2, OSWALD</Heading>
            <Heading htmlheading="h3" size="small" font="heading" stylingclasses="py-4">H3, OSWALD</Heading>
            <Heading htmlheading="h4" size="xsmall" font="heading" stylingclasses="py-4">H4, OSWALD</Heading>
            <Text teksttype="brødtekst">
            Her er en sektion brødtekst: Lorem ipsum dolor, sit amet consectetur adipisicing elit. Ullam dolorem doloremque commodi eaque quisquam quasi recusandae veniam. Corporis totam <Link href="#">Default link: </Link> reiciendis quibusdam ratione iure aut, numquam tenetur voluptatem exercitationem sequi enim!
            </Text>
            <Text teksttype="konsultativ">
            Her en sektion konsultativ tekst: Lorem ipsum dolor, sit amet consectetur adipisicing elit. Ullam dolorem doloremque commodi eaque quisquam quasi recusandae veniam. Corporis totam reiciendis quibusdam ratione iure aut, numquam tenetur voluptatem exercitationem sequi enim!
            </Text>
            <Text teksttype="brødtekst" stylingclasses="italic">
            Her er en sektion brødtekst med ekstra css: Lorem ipsum dolor, sit amet consectetur adipisicing elit. Ullam dolorem doloremque commodi eaque quisquam quasi recusandae veniam. Corporis totam <Link href="#">Default link: </Link> reiciendis quibusdam ratione iure aut, numquam tenetur voluptatem exercitationem sequi enim!
            </Text>
        </section>
        <!-- slut på typografi -->
        <hr class="my-4" />
        <!-- Link komponent instanser -->
        <section>
            <Heading htmlheading="h2" size="medium">Links</Heading>
            <Text teksttype="brødtekst"><Link href="#">Default link: </Link>Default linket er en del af en tekst, og burde gerne fungere som et <Link href="#">link</Link> i en paragraf.</Text>
            <Text><Link href="#" variant="primary" size="large">LINK VARIANT: PRIMARY SIZE LARGE</Link></Text>
            <Text><Link href="#" variant="primary" size="small">LINK VARIANT: PRIMARY SIZE SMALL</Link></Text>
            <Text><Link href="#" variant="secondary" size="large">LINK VARIANT: SECONDARY SIZE LARGE</Link></Text>
            <Text><Link href="#" variant="secondary" size="small">LINK VARIANT: SECONDARY SIZE SMALL</Link></Text>
            <Text><Link href="#" variant="tertiary" size="large">LINK VARIANT: TERTIARY SIZE LARGE</Link></Text>
            <Text><Link href="#" variant="tertiary" size="small">LINK VARIANT: TERTIARY SIZE SMALL</Link></Text>
        </section>
        <!-- Slut på Link komponent instanser -->
         <hr class="my-4" />
        <!-- Buttons komponent instanser -->
        <section>
            <Heading htmlheading="h2" size="medium">Buttons</Heading>
            <Text><Button href="#" variant="primary" size="large">LINK VARIANT: PRIMARY SIZE LARGE</Button></Text>
            <Text><Button href="#" variant="primary" size="small">LINK VARIANT: PRIMARY SIZE SMALL</Button></Text>
            <Text><Button href="#" variant="secondary" size="large">LINK VARIANT: SECONDARY SIZE LARGE</Button></Text>
            <Text><Button href="#" variant="secondary" size="small">LINK VARIANT: SECONDARY SIZE SMALL</Button></Text>
        </section>
        <!-- Slut på Buttons komponent instanser -->
           <section class="grid grid-cols-2 gap-2">
            <Aktivitet_card
            title="Sumobrydning"
            personer="+2 personer"
            tid="1 time"
            img="/sumobrydning.webp"
            pris="FRA 2500"
            badge="LEG"
            />
             <Aktivitet_card
            title="Sumobrydning"
            personer="+2 personer"
            tid="1 time"
            img="/sumobrydning.webp"
            pris="FRA 2500"
            badge="LEG"
            />
        </section>
        <section class="grid grid-cols-2 gap-2 lg:flex">
            <Insta_card
            likes="254"
            comments="5"
            caption="Kom ud i naturen og mærk suset🌿 Hos Adventure Park danner omgivelserne rammen for oplevelser, du ikke glemmer."
            img="/img/Instapost1.webp"
            />
            <Insta_card
            likes="254"
            comments="5"
            caption="Kom ud i naturen og mærk suset 🌿Hos Adventure Park danner omgivelserne rammen for oplevelser, du ikke glemmer."
            img="/img/instapost2.webp"
            />
            <Insta_card
            likes="254"
            comments="5"
            caption="Kom ud i naturen og mærk suset 🌿Hos Adventure Park danner omgivelserne rammen for oplevelser, du ikke glemmer."
            img="/img/instapost3.webp"
            />
            <Insta_card
            likes="254"
            comments="5"
            caption="Kom ud i naturen og mærk suset 🌿Hos Adventure Park danner omgivelserne rammen for oplevelser, du ikke glemmer."
            img="/img/instapost4.webp"
            />
        </section>
	</main>
</MainLayout>